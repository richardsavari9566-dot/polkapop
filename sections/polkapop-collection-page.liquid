{% liquid
  assign fallback_images = 'https://polkapop.in/cdn/shop/files/PolkaPOPlisting_cranberry__1-7-28.png?v=1757614865&width=700|https://polkapop.in/cdn/shop/files/PolkaPOPlisting_lime-lemon__1-7-21.png?v=1757614099&width=700|https://polkapop.in/cdn/shop/files/PolkaPOPlisting_orange__1-7-42.png?v=1757613060&width=700|https://polkapop.in/cdn/shop/files/PolkaPOPlisting_peach__1-7-35.png?v=1757612540&width=700' | split: '|'
  assign accents = '#e83d66|#78a820|#f27a20|#e8597b' | split: '|'
%}

<section id="polkapop-collection-{{ section.id }}" class="pp-collection-page">
  <div class="ppc-announcement">{{ section.settings.announcement }}</div>

  <header class="ppc-header">
    <nav class="ppc-nav" aria-label="Main navigation">
      <a class="ppc-brand ppc-brand-image-link" href="{{ routes.root_url }}" aria-label="{{ section.settings.brand | escape }}"><img class="ppc-site-logo-image" src="https://cdn.shopify.com/s/files/1/0955/2137/4497/files/Dark_BG_Logo_1_6143aa09-911f-49a9-8b15-48275bd4f292.avif?v=1785079527" alt="{{ section.settings.brand | escape }}" width="123" height="104" style="width:auto;height:48px;max-width:76px;object-fit:contain;display:block;"></a>
      <div class="ppc-menu">
        <a href="{{ routes.root_url }}#about">About us</a>
        <a href="{{ routes.all_products_collection_url }}">Collections</a>
        <a href="{{ routes.root_url }}#resources">Resources</a>
        <a href="{{ routes.root_url }}#packs">Combos</a>
        <a href="{{ routes.root_url }}#gift-packs">Gift Packs</a>
      </div>
      <div class="ppc-actions">
        <a class="ppc-cart" href="{{ routes.cart_url }}" aria-label="Cart">Cart</a>
        <a class="ppc-button" href="{{ routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      </div>
    </nav>
  </header>

  <main>
    <section class="ppc-product-hero-slider" aria-label="Polka Pop animated product banner">
      <div class="ppc-product-slide is-active">
        <img src="https://cdn.shopify.com/s/files/1/0955/2137/4497/files/polkapop-hero-banner.png?v=1783056098" alt="Polka Pop sparkling water flavours" width="1920" height="900" loading="eager">
        <div class="ppc-product-hero-copy">
          <span>{{ section.settings.hero_kicker }}</span>
          <h1>{{ collection.title | default: section.settings.hero_title }}</h1>
          <p>{{ collection.description | strip_html | default: section.settings.hero_text }}</p>
          <a class="ppc-button" href="#products">Shop Flavours</a>
        </div>
      </div>
      <div class="ppc-product-slide">
        <img src="https://cdn.shopify.com/s/files/1/0955/2137/4497/files/polkapop-hero-banner.png?v=1783056098" alt="Polka Pop sparkling water bottles" width="1920" height="900" loading="eager">
        <div class="ppc-product-hero-copy">
          <span>No sugar • Zero calories • Serve chilled</span>
          <h1>Pop Open Every Flavour</h1>
          <p>Explore Cranberry, Lemon-Lime, Orange and Peach in one colourful sparkling range.</p>
          <a class="ppc-button" href="#products">View All</a>
        </div>
      </div>
    </section>

    <section id="products" class="ppc-section">
      <div class="ppc-heading">
        <p class="ppc-kicker">{{ section.settings.products_kicker }}</p>
        <h2>{{ section.settings.products_title }}</h2>
        <p>{{ section.settings.products_text }}</p>
      </div>

      <div class="ppc-tabs" aria-label="Flavour filters">
        <button type="button" class="is-active">All</button>
        <button type="button">Cranberry</button>
        <button type="button">Lemon-Lime</button>
        <button type="button">Orange</button>
        <button type="button">Peach</button>
      </div>

      {% paginate collection.products by section.settings.products_per_page %}
        <div class="ppc-grid">
          {% if collection.products_count > 0 %}
            {% for product in collection.products %}
              {% assign card_index = forloop.index0 | modulo: 4 %}
              <article class="ppc-card" style="--accent: {{ accents[card_index] }}">
                <span class="ppc-status">{% if product.available %}Available{% else %}Sold out{% endif %}</span>
                <a class="ppc-product-image" href="{{ product.url }}">
                  {% if product.featured_image %}
                    {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title }}
                  {% else %}
                    <img src="{{ fallback_images[card_index] }}" alt="{{ product.title }}" width="700" height="700" loading="lazy">
                  {% endif %}
                </a>
                <div class="ppc-card-body">
                  <h3>{{ product.title }}</h3>
                  <p>{{ product.description | strip_html | truncate: 90 | default: section.settings.product_note }}</p>
                  <div class="ppc-meta"><span>300ml each</span><span>Pack of 12 / 24</span><span>Zero calories</span></div>
                  <div class="ppc-price-row">
                    <strong>{{ product.price | money_without_trailing_zeros }}</strong>
                    <a href="{{ product.url }}">{% if product.available %}View product{% else %}Notify me{% endif %}</a>
                  </div>
                </div>
              </article>
            {% endfor %}
          {% else %}
            {% for block in section.blocks %}
              {% if block.type == 'fallback_product' %}
                <article class="ppc-card" style="--accent: {{ block.settings.accent }}" {{ block.shopify_attributes }}>
                  <span class="ppc-status">{{ block.settings.status }}</span>
                  <a class="ppc-product-image" href="{{ block.settings.link }}">
                    <img src="{{ block.settings.image_url }}" alt="{{ block.settings.title }}" width="700" height="700" loading="lazy">
                  </a>
                  <div class="ppc-card-body">
                    <h3>{{ block.settings.title }}</h3>
                    <p>{{ block.settings.text }}</p>
                    <div class="ppc-meta"><span>300ml each</span><span>Pack of 12 / 24</span><span>Zero calories</span></div>
                    <div class="ppc-price-row"><strong>{{ block.settings.price }}</strong><a href="{{ block.settings.link }}">{{ block.settings.button_label }}</a></div>
                  </div>
                </article>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
        {% if paginate.pages > 1 %}
          <div class="ppc-pagination">{{ paginate | default_pagination: next: 'Next', previous: 'Previous' }}</div>
        {% endif %}
      {% endpaginate %}
    </section>

    <section id="benefits" class="ppc-benefits">
      {% for block in section.blocks %}
        {% if block.type == 'benefit' %}
          <article {{ block.shopify_attributes }}><span>{{ block.settings.label }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></article>
        {% endif %}
      {% endfor %}
    </section>

    <section id="packs" class="ppc-section ppc-packs-section">
      <div class="ppc-heading">
        <p class="ppc-kicker">{{ section.settings.pack_kicker }}</p>
        <h2>{{ section.settings.pack_title }}</h2>
        <p>{{ section.settings.pack_text }}</p>
      </div>
      <div class="ppc-packs">
        {% for block in section.blocks %}
          {% if block.type == 'pack' %}
            <article class="{% if block.settings.featured %}is-featured{% endif %}" {{ block.shopify_attributes }}>
              <span>{{ block.settings.label }}</span>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </section>

    <section id="faq" class="ppc-section">
      <div class="ppc-faq">
        <div>
          <p class="ppc-kicker">{{ section.settings.faq_kicker }}</p>
          <h2>{{ section.settings.faq_title }}</h2>
        </div>
        <div>
          {% for block in section.blocks %}
            {% if block.type == 'faq' %}
              <details{% if forloop.first %} open{% endif %} {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary><p>{{ block.settings.answer }}</p></details>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
  </main>
</section>

{% stylesheet %}
body:has(.pp-collection-page) .shopify-section-group-header-group,
body:has(.pp-collection-page) .shopify-section-group-footer-group,
body:has(.pp-collection-page) header.shopify-section,
body:has(.pp-collection-page) footer.shopify-section,
body:has(.pp-collection-page) .announcement-bar,
body:has(.pp-collection-page) .announcement-bar-section{display:none!important}
.pp-collection-page{--green:#087a48;--deep:#073f2c;--cream:#fbf7e8;--lime:#dcff4e;--ink:#20180f;--muted:#655f51;--line:#eadfbd;color:var(--ink);background:radial-gradient(circle at 12% 8%,rgba(220,255,78,.28),transparent 26rem),radial-gradient(circle at 88% 18%,rgba(255,111,71,.15),transparent 24rem),var(--cream);font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;min-height:100vh;overflow:hidden}.pp-collection-page *{box-sizing:border-box}.pp-collection-page a{text-decoration:none;color:inherit}.ppc-announcement{background:var(--deep);color:#fff;text-align:center;padding:10px 16px;font-weight:800;font-size:13px}.ppc-header{position:sticky;top:0;z-index:20;background:#fff;border-bottom:1px solid rgba(13,113,70,.1)}.ppc-nav{height:58px;display:flex;align-items:center;justify-content:space-between;gap:22px;max-width:1180px;margin:0 auto;padding:0 24px}.ppc-brand{display:flex;align-items:center;color:var(--green);font-family:Georgia,serif;font-size:26px;font-weight:950;letter-spacing:-.03em}.ppc-menu{display:flex;align-items:center;gap:24px;font-size:13px;font-weight:900;color:#153e2a}.ppc-menu a{white-space:nowrap}.ppc-actions{display:flex;align-items:center;gap:12px}.ppc-cart{display:grid;place-items:center;color:var(--green);font-size:20px;font-weight:900}.ppc-button,.ppc-price-row a{display:inline-flex;align-items:center;justify-content:center;border-radius:999px;background:var(--green);color:#fff;padding:15px 24px;font-weight:950;box-shadow:0 6px 0 #06482e}.ppc-hero{max-width:1240px;margin:30px auto 0;padding:0 24px;display:grid;grid-template-columns:1.02fr .98fr;gap:20px;min-height:540px}.ppc-hero-copy{position:relative;display:flex;flex-direction:column;justify-content:center;overflow:hidden;border-radius:30px;padding:64px;background:linear-gradient(135deg,#087a48,#063f2d);color:#fff;box-shadow:0 24px 70px rgba(8,65,42,.18)}.ppc-kicker{width:max-content;margin:0;background:var(--lime);color:var(--deep);border:2px solid var(--green);box-shadow:0 4px 0 var(--deep);border-radius:999px;padding:8px 14px;font-size:12px;font-weight:950}.ppc-hero h1,.ppc-heading h2,.ppc-faq h2{font-family:Georgia,"Times New Roman",serif;letter-spacing:0;line-height:.9;margin:18px 0 16px}.ppc-hero h1{font-size:76px;max-width:620px}.ppc-hero-copy>p:not(.ppc-kicker){font-size:18px;line-height:1.65;color:#eaf6e8;max-width:600px}.ppc-pills{display:flex;flex-wrap:wrap;gap:10px;margin-top:12px}.ppc-pills span{border:1px solid rgba(255,255,255,.28);background:rgba(255,255,255,.13);border-radius:999px;padding:9px 12px;font-size:12px;font-weight:900}.ppc-hero-art{position:relative;overflow:hidden;border-radius:30px;background:linear-gradient(145deg,#fff4dc,#ffe0c7);box-shadow:0 24px 70px rgba(8,65,42,.15)}.ppc-hero-art:before{content:"";position:absolute;inset:10%;border-radius:50%;background:rgba(220,255,78,.44);filter:blur(18px)}.ppc-bottle{position:absolute;width:43%;height:78%;object-fit:contain;filter:drop-shadow(0 24px 22px rgba(0,0,0,.18));animation:ppcFloat 4.8s ease-in-out infinite}.ppc-bottle-one{left:10%;top:8%;transform:rotate(-8deg)}.ppc-bottle-two{right:6%;top:15%;transform:rotate(7deg);animation-delay:.4s}.ppc-bottle-three{left:29%;bottom:2%;transform:scale(1.05);animation-delay:.8s}.ppc-section{max-width:1240px;margin:0 auto;padding:72px 24px}.ppc-heading{text-align:center;max-width:760px;margin:0 auto 30px}.ppc-heading .ppc-kicker{margin:0 auto}.ppc-heading h2,.ppc-faq h2{font-size:52px}.ppc-heading p:not(.ppc-kicker){color:var(--muted);line-height:1.65;font-size:17px}.ppc-tabs{display:flex;justify-content:center;flex-wrap:wrap;gap:9px;margin-bottom:24px}.ppc-tabs button{border:0;border-radius:999px;background:#fffdf4;color:#244b35;padding:12px 18px;font-weight:950;box-shadow:0 8px 20px rgba(8,65,42,.08)}.ppc-tabs .is-active{background:var(--green);color:#fff}.ppc-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}.ppc-card{position:relative;display:flex;flex-direction:column;min-height:520px;border-radius:30px;padding:18px;overflow:hidden;background:linear-gradient(180deg,color-mix(in srgb,var(--accent) 24%,#fff),#fff8ef);box-shadow:0 18px 54px rgba(8,65,42,.12);transition:transform .3s ease}.ppc-card:hover{transform:translateY(-7px)}.ppc-status{position:absolute;top:18px;left:18px;z-index:2;border-radius:999px;background:#fff;color:var(--accent);padding:8px 12px;font-size:12px;font-weight:950}.ppc-product-image{height:285px;display:grid;place-items:center}.ppc-product-image img{max-height:255px;width:auto;object-fit:contain;filter:drop-shadow(0 18px 18px rgba(0,0,0,.13))}.ppc-card-body{margin-top:auto;border:1px solid rgba(255,255,255,.72);border-radius:24px;background:rgba(255,255,255,.68);padding:18px;backdrop-filter:blur(10px)}.ppc-card h3{font-family:Georgia,serif;color:var(--accent);font-size:25px;line-height:1.05;margin:0 0 9px}.ppc-card p{color:#4f5147;line-height:1.5;margin:0 0 14px}.ppc-meta{display:flex;flex-wrap:wrap;gap:6px}.ppc-meta span{background:#fff;border-radius:999px;padding:6px 8px;font-size:11px;font-weight:850;color:#52614f}.ppc-price-row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:16px}.ppc-price-row strong{font-size:22px;color:var(--deep)}.ppc-price-row a{padding:11px 13px;font-size:12px;box-shadow:none}.ppc-benefits{max-width:1240px;margin:0 auto;padding:8px 24px 72px;display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.ppc-benefits article,.ppc-packs article,.ppc-faq details{background:#fffdf4;border:1px solid var(--line);border-radius:24px;padding:22px;box-shadow:0 12px 34px rgba(8,65,42,.07)}.ppc-benefits span,.ppc-packs span{display:inline-flex;border-radius:999px;background:var(--lime);color:var(--deep);padding:6px 10px;font-size:12px;font-weight:950}.ppc-benefits h3,.ppc-packs h3{font-family:Georgia,serif;font-size:28px;line-height:1;margin:14px 0 8px}.ppc-benefits p,.ppc-packs p,.ppc-faq p{color:var(--muted);line-height:1.6;margin:0}.ppc-packs{display:grid;grid-template-columns:1.1fr .9fr .9fr;gap:18px}.ppc-packs .is-featured{background:linear-gradient(135deg,var(--green),var(--deep));color:#fff}.ppc-packs .is-featured p{color:#edf8e8}.ppc-faq{display:grid;grid-template-columns:.8fr 1.2fr;gap:28px}.ppc-faq details{margin-bottom:12px}.ppc-faq summary{cursor:pointer;font-weight:950;color:var(--deep)}.ppc-pagination{text-align:center;margin-top:26px}@keyframes ppcFloat{0%,100%{translate:0 0}50%{translate:0 -14px}}@media(max-width:1020px){.ppc-nav{padding:0 24px}.ppc-hero{grid-template-columns:1fr}.ppc-grid{grid-template-columns:repeat(2,1fr)}.ppc-benefits{grid-template-columns:repeat(2,1fr)}.ppc-packs,.ppc-faq{grid-template-columns:1fr}.ppc-menu{display:none}}@media(max-width:640px){.ppc-nav{height:62px;padding:0 16px}.ppc-brand{font-size:28px}.ppc-cart{width:auto;height:auto}.ppc-button{display:none}.ppc-hero{padding:0 14px;margin-top:16px;min-height:auto}.ppc-hero-copy{padding:34px 24px;border-radius:24px}.ppc-hero h1{font-size:48px}.ppc-hero-art{min-height:340px;border-radius:24px}.ppc-bottle{width:62%;height:78%}.ppc-bottle-one{left:-4%;top:9%}.ppc-bottle-two{right:-6%;top:20%}.ppc-bottle-three{left:20%;bottom:4%}.ppc-section{padding:44px 14px}.ppc-heading h2,.ppc-faq h2{font-size:36px}.ppc-grid{grid-template-columns:1fr}.ppc-benefits{display:flex;overflow:auto;padding:0 14px 44px}.ppc-benefits article{min-width:230px}.ppc-card{min-height:500px}}
.ppc-product-hero-slider{position:relative;width:min(100%,1920px);aspect-ratio:1920/900;min-height:520px;max-height:900px;margin:0 auto;overflow:hidden;background:#ffe3d3;isolation:isolate}
.ppc-product-slide{position:absolute;inset:0;opacity:0;pointer-events:none;transition:opacity .8s ease,transform 6s ease;transform:scale(1.035)}
.ppc-product-slide.is-active{opacity:1;pointer-events:auto;transform:scale(1)}
.ppc-product-slide img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center center}
.ppc-product-slide:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(255,238,225,.92) 0%,rgba(255,238,225,.72) 34%,rgba(255,238,225,.2) 58%,rgba(255,238,225,0) 76%);z-index:1;pointer-events:none}
.ppc-product-hero-copy{position:relative;z-index:2;width:min(560px,44vw);padding:clamp(48px,7vw,116px) 0 0 clamp(28px,7vw,128px)}
.ppc-product-hero-copy span{display:inline-flex;border:2px solid var(--green);border-bottom-width:5px;border-radius:999px;background:var(--lime);color:var(--deep);padding:10px 18px;font-size:13px;font-weight:950}
.ppc-product-hero-copy h1{font-family:Georgia,"Times New Roman",serif;font-size:clamp(48px,6.8vw,104px);line-height:.9;color:var(--deep);margin:22px 0 16px}
.ppc-product-hero-copy p{font-size:18px;line-height:1.55;color:#31513e;font-weight:750;margin:0 0 24px;max-width:460px}
.ppc-card h3{font-size:20px;line-height:1.02;margin-bottom:6px}
.ppc-card p{font-size:12px;line-height:1.35;margin-bottom:12px}
@media(max-width:1020px){.ppc-product-hero-slider{min-height:460px}.ppc-product-hero-copy{width:min(520px,58vw);padding:58px 0 0 34px}}
@media(max-width:640px){.ppc-product-hero-slider{aspect-ratio:4/5;min-height:560px}.ppc-product-slide img{object-position:64% center}.ppc-product-slide:after{background:linear-gradient(180deg,rgba(255,238,225,.94),rgba(255,238,225,.48) 45%,rgba(255,238,225,0) 72%)}.ppc-product-hero-copy{width:auto;padding:34px 22px 0}.ppc-product-hero-copy h1{font-size:44px}.ppc-product-hero-copy p{font-size:15px;max-width:300px}}
{% endstylesheet %}

{% javascript %}
document.querySelectorAll('.pp-collection-page .ppc-tabs button').forEach((button) => {
  button.addEventListener('click', () => {
    button.closest('.ppc-tabs').querySelectorAll('button').forEach((item) => item.classList.remove('is-active'));
    button.classList.add('is-active');
  });
});
{% endjavascript %}

{% schema %}
{
  "name": "Polka Pop collection",
  "settings": [
    { "type": "text", "id": "announcement", "label": "Announcement", "default": "Zero sugar. Zero calories. Full fizz." },
    { "type": "text", "id": "brand", "label": "Brand", "default": "PolkaPop" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" },
    { "type": "text", "id": "hero_kicker", "label": "Hero kicker", "default": "Premium Sparkling Water" },
    { "type": "text", "id": "hero_title", "label": "Fallback hero title", "default": "Sparkling Water, But Louder" },
    { "type": "textarea", "id": "hero_text", "label": "Fallback hero text", "default": "Meet the colourful Polka Pop flavour range: zero sugar, zero calories and a whole lot of chilled sparkle." },
    { "type": "text", "id": "products_kicker", "label": "Products kicker", "default": "All Flavours" },
    { "type": "text", "id": "products_title", "label": "Products title", "default": "Choose Your Sparkling Sidekick" },
    { "type": "textarea", "id": "products_text", "label": "Products text", "default": "A clean, colourful collection layout with flavour tabs, rich product cards and better sold-out CTAs." },
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 4, "max": 24, "step": 4, "default": 12 },
    { "type": "textarea", "id": "product_note", "label": "Fallback product note", "default": "Crisp, fruity and refreshing without being sweet." },
    { "type": "text", "id": "pack_kicker", "label": "Pack kicker", "default": "Buying Guide" },
    { "type": "text", "id": "pack_title", "label": "Pack title", "default": "Not Sure What to Pick?" },
    { "type": "textarea", "id": "pack_text", "label": "Pack text", "default": "Helpful buying guidance for variety packs, party packs and gifting." },
    { "type": "text", "id": "faq_kicker", "label": "FAQ kicker", "default": "Need Help?" },
    { "type": "text", "id": "faq_title", "label": "FAQ title", "default": "Frequently Asked Questions" }
  ],
  "blocks": [
    {
      "type": "fallback_product",
      "name": "Fallback product",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Cranberry Sparkling Water" },
        { "type": "url", "id": "image_url", "label": "Image URL" },
        { "type": "text", "id": "status", "label": "Status", "default": "Sold out" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Crisp, fruity and refreshing without being sweet." },
        { "type": "text", "id": "price", "label": "Price", "default": "Rs. 480" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Notify me" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "accent", "label": "Accent color", "default": "#e83d66" }
      ]
    },
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Fizz" },
        { "type": "text", "id": "title", "label": "Title", "default": "Pure Fizz" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Light sparkle for daily sipping." }
      ]
    },
    {
      "type": "pack",
      "name": "Buying guide card",
      "settings": [
        { "type": "checkbox", "id": "featured", "label": "Featured card", "default": false },
        { "type": "text", "id": "label", "label": "Label", "default": "Pack" },
        { "type": "text", "id": "title", "label": "Title", "default": "Starter Variety Pack" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Best for first-time buyers who want to try every core flavour." }
      ]
    },
    {
      "type": "faq",
