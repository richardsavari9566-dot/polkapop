{% comment %}
  Polka Pop Collection Page - exact reproduction of the provided HTML wireframe.
  Hides the default theme header/footer and renders its own layout.
{% endcomment %}

<section id="polkapop-collection-{{ section.id }}" class="pp-col-v2">

  {% comment %} Site header now rendered globally from layout/theme.liquid via snippets/pp-header.liquid {% endcomment %}
  <main>

  <nav class="ppcv2-breadcrumb-wrap ppcv2-container" aria-label="Breadcrumb">
    <ol class="ppcv2-breadcrumb">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li aria-hidden="true">/</li>
      <li><span aria-current="page">Collections</span></li>
    </ol>
  </nav>

  <section class="ppcv2-hero ppcv2-container" aria-labelledby="ppcv2-page-title">
    <div class="ppcv2-hero-grid">
      <div class="ppcv2-hero-panel ppcv2-hero-left">
        {% assign slides = section.blocks | where: "type", "slide" %}
        {% if slides.size > 0 %}
          <div class="ppcv2-slider" role="region" aria-roledescription="carousel" aria-label="{{ section.settings.slider_label | default: 'Hero banner slideshow' }}" data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.autoplay_interval }}">
            <div class="ppcv2-slider-track">
              {% for block in slides %}
                <div class="ppcv2-slide{% if forloop.first %} is-active{% endif %}" role="group" aria-roledescription="slide" aria-label="Slide {{ forloop.index }} of {{ slides.size }}" {{ block.shopify_attributes }}>
                  {% if block.settings.link != blank %}<a href="{{ block.settings.link }}" class="ppcv2-slide-link" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}">{% endif %}
                    {% if block.settings.image != blank %}
                      <img
                        src="{{ block.settings.image | image_url: width: 1920 }}"
                        alt="{{ block.settings.alt | default: block.settings.image.alt | escape }}"
                        width="{{ block.settings.image.width }}"
                        height="{{ block.settings.image.height }}"
                        loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                        class="ppcv2-hero-banner-image"
                      >
                    {% else %}
                      {{ 'lifestyle-2' | placeholder_svg_tag: 'ppcv2-hero-banner-image ppcv2-placeholder-svg' }}
                    {% endif %}
                  {% if block.settings.link != blank %}</a>{% endif %}
                </div>
              {% endfor %}
            </div>

            {% if slides.size > 1 %}
              <button type="button" class="ppcv2-slider-arrow ppcv2-slider-prev" aria-label="Previous slide">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M13 4L7 10L13 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <button type="button" class="ppcv2-slider-arrow ppcv2-slider-next" aria-label="Next slide">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7 4L13 10L7 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>

              <div class="ppcv2-slider-dots" role="tablist" aria-label="Slide navigation">
                {% for block in slides %}
                  <button type="button" class="ppcv2-slider-dot{% if forloop.first %} is-active{% endif %}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Go to slide {{ forloop.index }}" data-index="{{ forloop.index0 }}"></button>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% else %}
          <img class="ppcv2-hero-banner-image" src="https://cdn.shopify.com/s/files/1/0955/2137/4497/files/pp-collection-hero-banner.png?v=1785648309" alt="Polka Pop hero banner showing a lifestyle scene with five sparkling water flavours displayed in front" width="1920" height="900" loading="eager">
        {% endif %}
      </div>
      <div class="ppcv2-hero-panel ppcv2-hero-right">
        <p class="ppcv2-eyebrow">Find your flavour</p>
        <h1 class="ppcv2-hero-title" id="ppcv2-page-title">Collections</h1>
        <p class="ppcv2-hero-desc">
          Explore the full sparkling-water range with a balanced five-product collection layout.
          The real product packshots are used only in the <strong>Shop the Collection</strong> section,
          while the header stays clean and abstract as requested.
        </p>
      </div>
    </div>
  </section>

  <section class="ppcv2-collections ppcv2-container" id="collections" aria-labelledby="ppcv2-collection-heading">
    <div class="ppcv2-collections-head">
      <div>
        <p class="ppcv2-eyebrow" style="color:var(--ppcv2-green); opacity:1;">Five sparkling flavours</p>
        <h2 class="ppcv2-section-title" id="ppcv2-collection-heading">Shop the collection</h2>
      </div>
    </div>

    <div class="ppcv2-product-grid">
      <a href="/products/blueberry-sparkling-water-300ml-each-packs-of-12-24" class="ppcv2-product-card" style="--card-bg:#eaf0fb; --title:#4e70c4;" aria-label="Blueberry Bliss – view product">
        <span class="ppcv2-hover-pill">Hover / tap for ingredients</span>
        <span class="ppcv2-ingredient ppcv2-i1"><strong>&#x1FAD0;</strong><small>Blueberry</small></span>
        <span class="ppcv2-ingredient ppcv2-i2"><strong>&#x1F4A7;</strong><small>Sparkling water</small></span>
        <span class="ppcv2-ingredient ppcv2-i3"><strong>&#x2744;&#xFE0F;</strong><small>Serve chill</small></span>
        <span class="ppcv2-ingredient ppcv2-i4"><strong>&#x2728;</strong><small>Zero sugar</small></span>
        <span class="ppcv2-product-stage">
          <img class="ppcv2-packshot" src="https://cdn.shopify.com/s/files/1/0955/2137/4497/files/pp-collection-blueberry.png?v=1785648309" alt="Polka Pop Blueberry bottle packshot" width="400" height="700" loading="lazy">
          <span class="ppcv2-product-title">Blueberry Bliss</span>
        </span>
      </a>

      <button class="ppcv2-product-card" style="--card-bg:#fbe6ec; --title:#d85273;" aria-label="Cranberry flavour">
        <span class="ppcv2-hover-pill">Hover / tap for ingredients</span>
        <span class="ppcv2-ingredient ppcv2-i1"><strong>&#x1F352;</strong><small>Cranberry</small></span>
        <span class="ppcv2-ingredient ppcv2-i2"><strong>&#x1F4A7;</strong><small>Sparkling water</small></span>
        <span class="ppcv2-ingredient ppcv2-i3"><strong>&#x2744;&#xFE0F;</strong><small>Serve chill</small></span>
        <span class="ppcv2-ingredient ppcv2-i4"><strong>&#x2728;</strong><small>Zero sugar</small></span>
        <span class="ppcv2-product-stage">
          <img class="ppcv2-packshot" src="https://cdn.shopify.com/s/files/1/0955/2137/4497/files/pp-collection-cranberry.png?v=1785648309" alt="Polka Pop Cranberry bottle packshot" width="400" height="700" loading="lazy">
          <span class="ppcv2-product-title">Cranberry Crush</span>
        </span>
      </button>

      <button class="ppcv2-product-card" style="--card-bg:#edf3d8; --title:#7c9a2a;" aria-label="Lemon Lime flavour">
        <span class="ppcv2-hover-pill">Hover / tap for ingredients</span>
        <span class="ppcv2-ingredient ppcv2-i1"><strong>&#x1F34B;</strong><small>Lemon</small></span>
        <span class="ppcv2-ingredient ppcv2-i2"><strong>&#x1F348;</strong><small>Lime</small></span>
        <span class="ppcv2-ingredient ppcv2-i3"><strong>&#x1F4A7;</strong><small>Sparkling water</small></span>
        <span class="ppcv2-ingredient ppcv2-i4"><strong>&#x2728;</strong><small>Zero sugar</small></span>
        <span class="ppcv2-product-stage">
          <img class="ppcv2-packshot" src="https://cdn.shopify.com/s/files/1/0955/2137/4497/files/pp-collection-lemon-lime.png?v=1785648309" alt="Polka Pop Lemon Lime bottle packshot" width="400" height="700" loading="lazy">
          <span class="ppcv2-product-title">Lemon Lime Lift</span>
        </span>
      </button>

      <button class="ppcv2-product-card" style="--card-bg:#fff0df; --title:#f08b22;" aria-label="Orange flavour">
        <span class="ppcv2-hover-pill">Hover / tap for ingredients</span>
        <span class="ppcv2-ingredient ppcv2-i1"><strong>&#x1F34A;</strong><small>Orange</small></span>
        <span class="ppcv2-ingredient ppcv2-i2"><strong>&#x1F4A7;</strong><small>Sparkling water</small></span>
        <span class="ppcv2-ingredient ppcv2-i3"><strong>&#x2744;&#xFE0F;</strong><small>Serve chill</small></span>
        <span class="ppcv2-ingredient ppcv2-i4"><strong>&#x2728;</strong><small>Zero sugar</small></span>
        <span class="ppcv2-product-stage">
          <img class="ppcv2-packshot" src="https://cdn.shopify.com/s/files/1/0955/2137/4497/files/pp-collection-orange.png?v=1785648308" alt="Polka Pop Orange bottle packshot" width="400" height="700" loading="lazy">
          <span class="ppcv2-product-title">Orange Spark</span>
        </span>
      </button>

      <button class="ppcv2-product-card" style="--card-bg:#f9e7df; --title:#ca6686;" aria-label="Peach flavour">
        <span class="ppcv2-hover-pill">Hover / tap for ingredients</span>
        <span class="ppcv2-ingredient ppcv2-i1"><strong>&#x1F351;</strong><small>Peach</small></span>
        <span class="ppcv2-ingredient ppcv2-i2"><strong>&#x1F4A7;</strong><small>Sparkling water</small></span>
        <span class="ppcv2-ingredient ppcv2-i3"><strong>&#x2744;&#xFE0F;</strong><small>Serve chill</small></span>
        <span class="ppcv2-ingredient ppcv2-i4"><strong>&#x2728;</strong><small>Zero sugar</small></span>
        <span class="ppcv2-product-stage">
          <img class="ppcv2-packshot" src="https://cdn.shopify.com/s/files/1/0955/2137/4497/files/pp-collection-peach.png?v=1785648309" alt="Polka Pop Peach bottle packshot" width="400" height="700" loading="lazy">
          <span class="ppcv2-product-title">Peach Pop</span>
        </span>
      </button>
    </div>
  </section>

  <section class="ppcv2-faq ppcv2-container" aria-labelledby="ppcv2-faq-heading">
    <div class="ppcv2-faq-wrap">
      <div class="ppcv2-faq-heading-group">
        <p class="ppcv2-faq-kicker">Need help?</p>
        <h2 class="ppcv2-faq-title" id="ppcv2-faq-heading">Frequently Asked Questions</h2>
      </div>
      <div class="ppcv2-accordion">
        <article class="ppcv2-faq-item">
          <button class="ppcv2-faq-question" aria-expanded="false"><span>What makes Polka Pop different?</span><span class="ppcv2-plus">+</span></button>
          <div class="ppcv2-faq-answer"><p>Use this space for your approved positioning, flavour proposition and what makes the sparkling-water range stand out.</p></div>
        </article>
        <article class="ppcv2-faq-item">
          <button class="ppcv2-faq-question" aria-expanded="false"><span>Are these the real collection packshots?</span><span class="ppcv2-plus">+</span></button>
          <div class="ppcv2-faq-answer"><p>Yes. The Shop the Collection section has been updated with your real product packshots. The header intentionally does not use these packshots.</p></div>
        </article>
        <article class="ppcv2-faq-item">
          <button class="ppcv2-faq-question" aria-expanded="false"><span>How many flavours are shown in the collection?</span><span class="ppcv2-plus">+</span></button>
          <div class="ppcv2-faq-answer"><p>The collection section now shows the five individual Polka Pop flavours only: Blueberry, Cranberry, Lemon Lime, Orange and Peach.</p></div>
        </article>
        <article class="ppcv2-faq-item">
          <button class="ppcv2-faq-question" aria-expanded="false"><span>How does the ingredient interaction work?</span><span class="ppcv2-plus">+</span></button>
          <div class="ppcv2-faq-answer"><p>When a user hovers on desktop, or taps on mobile, ingredient badges animate out around the bottle or variety-pack tile.</p></div>
        </article>
        <article class="ppcv2-faq-item">
          <button class="ppcv2-faq-question" aria-expanded="false"><span>Can the tile text be changed later?</span><span class="ppcv2-plus">+</span></button>
          <div class="ppcv2-faq-answer"><p>Yes. This file is editable HTML, so product titles, colours, FAQs and CTA content can all be updated later.</p></div>
        </article>
        <article class="ppcv2-faq-item">
          <button class="ppcv2-faq-question" aria-expanded="false"><span>Is this wireframe responsive?</span><span class="ppcv2-plus">+</span></button>
          <div class="ppcv2-faq-answer"><p>Yes. The layout adapts across desktop, tablet and mobile, and the hover effect becomes tap-friendly on smaller screens.</p></div>
        </article>
      </div>
    </div>
  </section>

  <section class="ppcv2-cta-section ppcv2-container">
    <div class="ppcv2-cta-box">
      <span class="ppcv2-cta-fruit ppcv2-cf1">&#x1F352;</span>
      <span class="ppcv2-cta-fruit ppcv2-cf2">&#x1F34F;</span>
      <span class="ppcv2-cta-fruit ppcv2-cf3">&#x1F34B;</span>
      <span class="ppcv2-cta-fruit ppcv2-cf4">&#x1FAD0;</span>
      <div>
        <p class="ppcv2-eyebrow">Ready to sip?</p>
        <h2 class="ppcv2-cta-title">Don't Wait &ndash; Purchase Now!</h2>
        <p>
          A clean, reference-inspired collection page with five product tiles, real packshots in the product section, interactive ingredient reveals and Montserrat typography throughout.
        </p>
        <a class="ppcv2-cta-btn" href="#collections">View Products</a>
      </div>
    </div>
  </section>
  </main>

  <footer class="ppcv2-footer">
    <div class="ppcv2-container">
      <div class="ppcv2-footer-main">
        <div class="ppcv2-footer-brand">
          <a class="ppcv2-footer-logo" href="{{ routes.root_url }}" aria-label="Polka Pop home"><img class="ppcv2-footer-logo-image" src="https://cdn.shopify.com/s/files/1/0955/2137/4497/files/pp-collection-logo.png?v=1785648309" alt="Polka Pop logo" width="112" height="112" loading="lazy"></a>
        </div>

        <div class="ppcv2-footer-column">
          <h3>Quick links</h3>
          <ul>
            <li><a href="#">About Us</a></li>
            <li><a href="#">Media Centre</a></li>
            <li><a href="#">Recipe Library</a></li>
            <li><a href="#">Contact Us</a></li>
          </ul>
        </div>

        <div class="ppcv2-footer-column">
          <h3>Store Policies</h3>
          <ul>
            <li><a href="#">Privacy Policy</a></li>
            <li><a href="#">Terms &amp; Conditions</a></li>
            <li><a href="#">Shipping &amp; Refund</a></li>
            <li><a href="#ppcv2-faq-heading">Frequently Asked Questions</a></li>
          </ul>
        </div>

        <div class="ppcv2-footer-column">
          <h3>Categories</h3>
          <ul>
            <li><a href="#">Cocktail Mixers</a></li>
            <li><a href="#">Party Packs</a></li>
            <li><a href="#">Appreciation Packs</a></li>
            <li><a href="#">Barware Accessories</a></li>
            <li><a href="#">HUSTLE Energy Drink</a></li>
          </ul>
        </div>
      </div>

      <div class="ppcv2-footer-lower">
        <div class="ppcv2-footer-newsletter">
          <h3>Subscribe to our emails</h3>
          <form class="ppcv2-footer-newsletter-form" onsubmit="event.preventDefault(); this.querySelector('button').textContent='✓';">
            <input type="email" aria-label="Email address" placeholder="Email" required>
            <button type="submit" aria-label="Subscribe">&rarr;</button>
          </form>
        </div>

        <div class="ppcv2-footer-social" aria-label="Social media links">
          <a href="#" aria-label="Facebook">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 22v-8h2.8l.4-3.2h-3.2V8.7c0-.9.3-1.6 1.7-1.6h1.7V4.2c-.3 0-1.3-.2-2.5-.2-2.5 0-4.2 1.5-4.2 4.4v2.4H7.4V14h2.8v8h3.3Z"/></svg>
          </a>
          <a href="#" aria-label="Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.2 2h9.6A5.2 5.2 0 0 1 22 7.2v9.6a5.2 5.2 0 0 1-5.2 5.2H7.2A5.2 5.2 0 0 1 2 16.8V7.2A5.2 5.2 0 0 1 7.2 2Zm0 2A3.2 3.2 0 0 0 4 7.2v9.6A3.2 3.2 0 0 0 7.2 20h9.6a3.2 3.2 0 0 0 3.2-3.2V7.2A3.2 3.2 0 0 0 16.8 4H7.2Zm10.1 1.5a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"/></svg>
          </a>
          <a href="#" aria-label="YouTube">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23 12s0-3.4-.4-5c-.2-.9-.9-1.6-1.8-1.8C19.3 4.8 12 4.8 12 4.8s-7.3 0-8.8.4C2.3 5.4 1.6 6.1 1.4 7 1 8.6 1 12 1 12s0 3.4.4 5c.2.9.9 1.6 1.8 1.8 1.5.4 8.8.4 8.8.4s7.3 0 8.8-.4c.9-.2 1.6-.9 1.8-1.8.4-1.6.4-5 .4-5ZM9.8 15.4V8.6l5.9 3.4-5.9 3.4Z"/></svg>
          </a>
        </div>
      </div>

      <div class="ppcv2-footer-bottom">
        <span>&copy; 2026 Polka Pop. All rights reserved.</span>
        <span>Premium sparkling water collection.</span>
      </div>
    </div>
  </footer>

</section>

{% stylesheet %}
body:has(.pp-col-v2) .shopify-section-group-header-group,
body:has(.pp-col-v2) .shopify-section-group-footer-group,
body:has(.pp-col-v2) header.shopify-section,
body:has(.pp-col-v2) footer.shopify-section,
body:has(.pp-col-v2) .announcement-bar,
body:has(.pp-col-v2) .announcement-bar-section{display:none!important}

.pp-col-v2{
  --ppcv2-bg:#f8f8ec;
  --ppcv2-card-shadow:0 18px 44px rgba(15,23,42,.12);
  --ppcv2-green:#0b7b56;
  --ppcv2-green-dark:#075b40;
  --ppcv2-lime:#d6ef58;
  --ppcv2-text:#111827;
  --ppcv2-muted:#586068;
  --ppcv2-radius:24px;
  --ppcv2-max:1440px;
  font-family:'Montserrat',Arial,sans-serif;
  color:var(--ppcv2-text);
  background:var(--ppcv2-bg);
  line-height:1.45;
}
.pp-col-v2 *{box-sizing:border-box}
.pp-col-v2 img{display:block;max-width:100%}
.pp-col-v2 button,.pp-col-v2 a,.pp-col-v2 input{font:inherit}
.pp-col-v2 a{color:inherit;text-decoration:none}
.ppcv2-container{width:min(var(--ppcv2-max),calc(100% - 40px));margin-inline:auto}

.ppcv2-header{position:sticky;top:0;z-index:40;background:rgba(248,248,236,.94);backdrop-filter:blur(12px);border-bottom:1px solid rgba(11,123,86,.12)}
.ppcv2-nav{height:76px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:28px}
.ppcv2-brand{display:inline-flex;align-items:center}
.ppcv2-nav-links{display:flex;justify-self:center;gap:30px;font-size:14px;font-weight:600;align-items:center}
.ppcv2-nav-links a::after{content:"\2304";font-size:11px;margin-left:6px;opacity:.6}
.ppcv2-nav-links a:last-child::after{display:none}
.ppcv2-nav-icons{display:flex;gap:16px;align-items:center;font-size:17px}
.ppcv2-nav-icons span{width:34px;height:34px;display:grid;place-items:center;border-radius:50%}
.ppcv2-nav-icons span:hover{background:#ecf5de}

.ppcv2-breadcrumb-wrap{padding-top:18px;padding-bottom:6px}
.ppcv2-breadcrumb{list-style:none;padding:0;margin:0;display:flex;align-items:center;gap:10px;font-size:13px;font-weight:600;color:var(--ppcv2-muted)}
.ppcv2-breadcrumb a{color:var(--ppcv2-green);transition:opacity .2s ease}
.ppcv2-breadcrumb a:hover{opacity:.7}
.ppcv2-breadcrumb span[aria-current="page"]{color:var(--ppcv2-text)}

.ppcv2-hero{padding:12px 0 54px}
.ppcv2-hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;min-height:390px}
.ppcv2-hero-panel{border-radius:10px;overflow:hidden;position:relative}
.ppcv2-hero-left{min-height:390px;background:#f4f4ef;display:flex;align-items:stretch;justify-content:center}
.ppcv2-hero-banner-image{width:100%;height:100%;object-fit:cover;object-position:center;display:block;transform:scale(1);transition:transform 1.8s ease;will-change:transform}
.ppcv2-hero-left:hover .ppcv2-hero-banner-image{transform:scale(1.06)}
.ppcv2-hero-right{background:var(--ppcv2-green);color:white;padding:60px 54px;display:flex;flex-direction:column;justify-content:center;min-height:390px}
.ppcv2-eyebrow{margin:0 0 12px;font-size:13px;letter-spacing:.14em;text-transform:uppercase;font-weight:700;opacity:.86}
.ppcv2-hero-title,.ppcv2-section-title,.ppcv2-faq-title,.ppcv2-cta-title{margin:0;letter-spacing:-.04em;line-height:1;font-weight:800}
.ppcv2-hero-title{font-size:clamp(42px,5vw,68px);margin-bottom:18px}
.ppcv2-hero-desc{max-width:590px;margin:0;font-size:16px;line-height:1.7}

/* --- Slider styles --- */
.ppcv2-slider{position:relative;width:100%;height:100%;overflow:hidden}
.ppcv2-slider-track{display:flex;height:100%;transition:transform .5s cubic-bezier(.4,0,.2,1)}
.ppcv2-slide{flex:0 0 100%;min-width:0;height:100%;position:relative}
.ppcv2-slide img,.ppcv2-slide svg{width:100%;height:100%;object-fit:cover;object-position:center;display:block}
.ppcv2-slide-link{display:block;width:100%;height:100%}
.ppcv2-placeholder-svg{width:100%;height:100%}

.ppcv2-slider-arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:40px;height:40px;border-radius:50%;border:0;background:rgba(255,255,255,.85);color:var(--ppcv2-text);cursor:pointer;display:grid;place-items:center;backdrop-filter:blur(6px);box-shadow:0 2px 8px rgba(0,0,0,.12);transition:background .2s ease,opacity .2s ease;opacity:.7}
.ppcv2-slider-arrow:hover,.ppcv2-slider-arrow:focus-visible{opacity:1;background:#fff;outline:2px solid var(--ppcv2-green);outline-offset:2px}
.ppcv2-slider-prev{left:12px}
.ppcv2-slider-next{right:12px}

.ppcv2-slider-dots{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);display:flex;gap:8px;z-index:3}
.ppcv2-slider-dot{width:10px;height:10px;border-radius:50%;border:2px solid #fff;background:transparent;cursor:pointer;padding:0;transition:background .2s ease,transform .2s ease;box-shadow:0 1px 4px rgba(0,0,0,.18)}
.ppcv2-slider-dot.is-active{background:#fff;transform:scale(1.25)}
.ppcv2-slider-dot:focus-visible{outline:2px solid var(--ppcv2-green);outline-offset:2px}

/* Pause indicator */
.ppcv2-slider[aria-live="off"] .ppcv2-slider-dots::before{content:"";display:none}

@keyframes ppcv2-float{50%{transform:translateY(-10px) rotate(3deg)}}

.ppcv2-collections{padding-bottom:78px}
.ppcv2-collections-head{display:flex;justify-content:center;align-items:center;text-align:center;gap:24px;margin-bottom:28px}
.ppcv2-section-title{font-size:clamp(34px,4.5vw,58px);text-align:center}
.ppcv2-section-copy{margin:0;max-width:620px;color:var(--ppcv2-muted);font-size:15px;line-height:1.7}

.ppcv2-product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
.ppcv2-product-card{position:relative;min-height:520px;border-radius:24px;overflow:hidden;background:var(--card-bg);box-shadow:0 0 0 1px rgba(17,24,39,.04);transition:transform .32s ease,box-shadow .32s ease;cursor:pointer;border:0;text-align:left;padding:0;isolation:isolate}
.ppcv2-product-card:hover,.ppcv2-product-card:focus-visible,.ppcv2-product-card.is-active{transform:translateY(-8px);box-shadow:var(--ppcv2-card-shadow);outline:none}
.ppcv2-product-stage{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;padding:22px 22px 24px}
.ppcv2-product-stage::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 50% 24%,rgba(255,255,255,.88),transparent 35%),linear-gradient(to bottom,rgba(255,255,255,.18),transparent 34%);z-index:-1}
.ppcv2-packshot{width:auto;height:350px;max-width:72%;object-fit:contain;filter:drop-shadow(0 18px 20px rgba(15,23,42,.18));transition:transform .4s cubic-bezier(.2,.8,.2,1);z-index:2;pointer-events:none}
.ppcv2-product-card:hover .ppcv2-packshot,.ppcv2-product-card:focus-visible .ppcv2-packshot,.ppcv2-product-card.is-active .ppcv2-packshot{transform:scale(.92) translateY(-6px)}
.ppcv2-product-title{margin-top:14px;font-size:17px;line-height:1.25;font-weight:800;color:var(--title);text-align:center;letter-spacing:-.02em}
.ppcv2-hover-pill{position:absolute;top:18px;left:18px;border-radius:999px;background:rgba(255,255,255,.85);padding:8px 12px;font-size:12px;font-weight:700;z-index:7;backdrop-filter:blur(10px);transition:opacity .2s ease}
.ppcv2-product-card:hover .ppcv2-hover-pill,.ppcv2-product-card.is-active .ppcv2-hover-pill{opacity:0}

.ppcv2-ingredient{position:absolute;width:92px;height:92px;border-radius:50%;background:rgba(255,255,255,.95);border:2px solid rgba(255,255,255,.96);box-shadow:0 14px 28px rgba(15,23,42,.14);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:3px;z-index:5;opacity:0;transform:translate(var(--dx),var(--dy)) scale(.2) rotate(-12deg);transition:opacity .28s ease,transform .46s cubic-bezier(.18,.9,.2,1.25);pointer-events:none}
.ppcv2-ingredient::after{content:"";position:absolute;inset:-11px;border:1px dashed rgba(17,24,39,.16);border-radius:50%;animation:ppcv2-spin 10s linear infinite}
.ppcv2-ingredient strong{font-size:34px;line-height:1}
.ppcv2-ingredient small{font-size:10px;font-weight:800;text-transform:uppercase;line-height:1.1;letter-spacing:.05em}
.ppcv2-i1{left:26px;top:76px;--dx:102px;--dy:78px}
.ppcv2-i2{right:26px;top:84px;--dx:-102px;--dy:76px}
.ppcv2-i3{left:42px;bottom:88px;--dx:100px;--dy:-74px}
.ppcv2-i4{right:42px;bottom:86px;--dx:-100px;--dy:-74px}

.ppcv2-product-card:hover .ppcv2-ingredient,.ppcv2-product-card:focus-visible .ppcv2-ingredient,.ppcv2-product-card.is-active .ppcv2-ingredient{opacity:1;transform:translate(0,0) scale(1) rotate(0deg)}

@keyframes ppcv2-spin{to{transform:rotate(360deg)}}

.ppcv2-faq{padding-bottom:72px}
.ppcv2-faq-wrap{max-width:1080px;margin-inline:auto}
.ppcv2-faq-heading-group{text-align:center}
.ppcv2-faq-kicker{margin:0 0 6px;font-size:13px;font-weight:700}
.ppcv2-faq-title{font-size:clamp(34px,4.5vw,56px);margin-bottom:20px;text-align:center}
.ppcv2-accordion{display:grid;gap:15px}
.ppcv2-faq-item{background:var(--ppcv2-lime);border-radius:12px;overflow:hidden;border:2px solid var(--ppcv2-green);box-shadow:0 5px 0 var(--ppcv2-green-dark)}
.ppcv2-faq-question{width:100%;border:0;background:transparent;padding:17px 20px;text-align:left;font-weight:700;font-size:16px;display:flex;align-items:center;justify-content:space-between;cursor:pointer}
.ppcv2-faq-answer{max-height:0;overflow:hidden;transition:max-height .35s ease;background:rgba(255,255,255,.32)}
.ppcv2-faq-answer p{margin:0;padding:0 20px 20px;color:#24362f;font-size:14px;line-height:1.7}
.ppcv2-faq-item.open .ppcv2-faq-answer{max-height:180px}
.ppcv2-faq-item.open .ppcv2-faq-question .ppcv2-plus{transform:rotate(45deg)}
.ppcv2-plus{font-size:24px;transition:transform .25s ease}

.ppcv2-cta-section{padding-bottom:110px}
.ppcv2-cta-box{max-width:1080px;margin-inline:auto;background:var(--ppcv2-green);color:white;border-radius:18px;min-height:318px;position:relative;overflow:hidden;display:grid;place-items:center;text-align:center;padding:58px 26px}
.ppcv2-cta-box p{margin:0 auto 20px;max-width:680px;line-height:1.7}
.ppcv2-cta-title{font-size:clamp(34px,4.8vw,56px);margin-bottom:16px}
.ppcv2-cta-btn{display:inline-flex;align-items:center;justify-content:center;min-width:168px;min-height:52px;border-radius:999px;background:var(--ppcv2-lime);color:#16372c;font-weight:800;box-shadow:0 4px 0 #243f38}
.ppcv2-cta-fruit{position:absolute;font-size:48px;opacity:.96;animation:ppcv2-float 4s ease-in-out infinite}
.ppcv2-cf1{left:9%;top:14%}
.ppcv2-cf2{right:8%;top:14%;animation-delay:.9s}
.ppcv2-cf3{left:12%;bottom:12%;animation-delay:1.7s}
.ppcv2-cf4{right:12%;bottom:12%;animation-delay:2.2s}

.ppcv2-footer{background:var(--ppcv2-green);color:#ffffff;padding:64px 0 28px}
.ppcv2-footer-main{display:grid;grid-template-columns:1.1fr 1fr 1fr 1.1fr;gap:54px;align-items:start}
.ppcv2-footer-brand{display:flex;flex-direction:column;align-items:flex-start}
.ppcv2-footer-logo{display:inline-flex;align-items:center;margin-bottom:0}
.ppcv2-footer-logo-image{height:96px;width:auto;display:block}
.ppcv2-footer-column h3{margin:0 0 24px;font-size:20px;font-weight:800;color:#ffffff;letter-spacing:-.02em}
.ppcv2-footer-column ul{list-style:none;padding:0;margin:0;display:grid;gap:18px}
.ppcv2-footer-column a{color:rgba(255,255,255,.78);font-size:15px;font-weight:500;transition:color .2s ease,transform .2s ease;display:inline-block}
.ppcv2-footer-column a:hover{color:#ffffff;transform:translateX(3px)}
.ppcv2-footer-lower{display:flex;justify-content:space-between;align-items:flex-end;gap:40px;margin-top:48px}
.ppcv2-footer-newsletter{width:min(100%,460px)}
.ppcv2-footer-newsletter h3{margin:0 0 18px;font-size:20px;font-weight:600;color:#ffffff}
.ppcv2-footer-newsletter-form{display:flex;align-items:center;min-height:58px;border:1.5px solid rgba(255,255,255,.72);border-radius:999px;padding:0 18px 0 24px;background:transparent}
.ppcv2-footer-newsletter-form input{flex:1;border:0;outline:none;background:transparent;color:#ffffff;font-size:16px;min-width:0}
.ppcv2-footer-newsletter-form input::placeholder{color:rgba(255,255,255,.68)}
.ppcv2-footer-newsletter-form button{border:0;background:transparent;color:#ffffff;font-size:24px;cursor:pointer;width:42px;height:42px;display:grid;place-items:center;border-radius:50%;transition:background .2s ease}
.ppcv2-footer-newsletter-form button:hover{background:rgba(255,255,255,.12)}
.ppcv2-footer-social{display:flex;align-items:center;gap:24px;padding-bottom:10px}
.ppcv2-footer-social a{width:32px;height:32px;display:grid;place-items:center;border-radius:50%;color:#ffffff;transition:background .2s ease,transform .2s ease}
.ppcv2-footer-social a:hover{background:rgba(255,255,255,.12);transform:translateY(-2px)}
.ppcv2-footer-social svg{width:22px;height:22px;fill:currentColor}
.ppcv2-footer-bottom{margin-top:42px;padding-top:20px;border-top:1px solid rgba(255,255,255,.18);display:flex;justify-content:space-between;gap:18px;color:rgba(255,255,255,.62);font-size:12px}

@media(max-width:1024px){
  .ppcv2-hero-grid{grid-template-columns:1fr}
  .ppcv2-collections-head{display:flex}
  .ppcv2-product-grid{grid-template-columns:repeat(2,1fr)}
  .ppcv2-footer-main{grid-template-columns:repeat(2,1fr)}
  .ppcv2-footer-lower{align-items:flex-start}
}

@media(max-width:700px){
  .ppcv2-container{width:min(100% - 24px,var(--ppcv2-max))}
  .ppcv2-nav{height:64px}
  .ppcv2-brand img{height:44px!important}
  .ppcv2-footer-logo-image{height:78px}
  .ppcv2-nav-links{display:none}
  .ppcv2-hero-left,.ppcv2-hero-right{min-height:320px}
  .ppcv2-hero-right{padding:38px 26px}
  .ppcv2-product-grid{grid-template-columns:1fr;gap:18px}
