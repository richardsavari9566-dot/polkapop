  .ppcv2-packshot{width:auto;height:330px;max-width:72%}
  .ppcv2-ingredient{width:84px;height:84px}
  .ppcv2-footer-main{grid-template-columns:1fr;gap:34px}
  .ppcv2-footer-lower{flex-direction:column;align-items:stretch;margin-top:38px}
  .ppcv2-footer-social{padding-bottom:0}
  .ppcv2-footer-bottom{flex-direction:column}
  .ppcv2-slider-arrow{width:34px;height:34px}
  .ppcv2-slider-prev{left:8px}
  .ppcv2-slider-next{right:8px}
}

@media(max-width:430px){
  .ppcv2-product-card{min-height:470px}
  .ppcv2-packshot{height:305px;max-width:76%}
  .ppcv2-ingredient{width:76px;height:76px}
  .ppcv2-ingredient strong{font-size:29px}
  .ppcv2-product-title{font-size:16px}
}

@media(prefers-reduced-motion:reduce){
  .pp-col-v2 *,.pp-col-v2 *::before,.pp-col-v2 *::after{animation:none!important;transition:none!important}
  .ppcv2-hero-left:hover .ppcv2-hero-banner-image{transform:none!important}
  .ppcv2-slider-track{transition:none!important}
}
{% endstylesheet %}

{% javascript %}
/* Product card interactions */
const cards = document.querySelectorAll('.ppcv2-product-card');
cards.forEach(card => {
  card.addEventListener('click', () => {
    const wasActive = card.classList.contains('is-active');
    cards.forEach(c => c.classList.remove('is-active'));
    if (!wasActive) card.classList.add('is-active');
  });
  card.addEventListener('keydown', event => {
    if (event.key === 'Escape') card.classList.remove('is-active');
  });
});

document.addEventListener('click', event => {
  if (!event.target.closest('.ppcv2-product-card')) {
    cards.forEach(c => c.classList.remove('is-active'));
  }
});

/* FAQ accordion */
document.querySelectorAll('.ppcv2-faq-question').forEach(button => {
  button.addEventListener('click', () => {
    const item = button.closest('.ppcv2-faq-item');
    const open = item.classList.toggle('open');
    button.setAttribute('aria-expanded', String(open));
  });
});

/* Hero slider */
document.querySelectorAll('.ppcv2-slider').forEach(slider => {
  const track = slider.querySelector('.ppcv2-slider-track');
  const slides = slider.querySelectorAll('.ppcv2-slide');
  const dots = slider.querySelectorAll('.ppcv2-slider-dot');
  const prevBtn = slider.querySelector('.ppcv2-slider-prev');
  const nextBtn = slider.querySelector('.ppcv2-slider-next');
  const total = slides.length;
  if (total < 2) return;

  let current = 0;
  let autoplayTimer = null;
  let paused = false;
  const autoplay = slider.dataset.autoplay === 'true';
  const interval = parseInt(slider.dataset.interval, 10) || 5000;

  function goTo(index, announce) {
    current = ((index % total) + total) % total;
    track.style.transform = 'translateX(-' + (current * 100) + '%)';
    slides.forEach((s, i) => {
      s.classList.toggle('is-active', i === current);
      const link = s.querySelector('.ppcv2-slide-link');
      if (link) link.tabIndex = i === current ? 0 : -1;
    });
    dots.forEach((d, i) => {
      d.classList.toggle('is-active', i === current);
      d.setAttribute('aria-selected', String(i === current));
    });
    if (announce !== false) {
      slider.setAttribute('aria-live', paused ? 'polite' : 'off');
    }
  }

  function startAutoplay() {
    if (!autoplay) return;
    stopAutoplay();
    autoplayTimer = setInterval(() => goTo(current + 1), interval);
    slider.setAttribute('aria-live', 'off');
  }

  function stopAutoplay() {
    if (autoplayTimer) { clearInterval(autoplayTimer); autoplayTimer = null; }
    slider.setAttribute('aria-live', 'polite');
  }

  if (prevBtn) prevBtn.addEventListener('click', () => { goTo(current - 1); resetAutoplay(); });
  if (nextBtn) nextBtn.addEventListener('click', () => { goTo(current + 1); resetAutoplay(); });

  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      goTo(parseInt(dot.dataset.index, 10));
      resetAutoplay();
    });
  });

  function resetAutoplay() {
    if (autoplay && !paused) startAutoplay();
  }

  /* Pause on hover / focus */
  slider.addEventListener('mouseenter', () => { paused = true; stopAutoplay(); });
  slider.addEventListener('mouseleave', () => { paused = false; if (autoplay) startAutoplay(); });
  slider.addEventListener('focusin', () => { paused = true; stopAutoplay(); });
  slider.addEventListener('focusout', (e) => {
    if (!slider.contains(e.relatedTarget)) { paused = false; if (autoplay) startAutoplay(); }
  });

  /* Keyboard navigation */
  slider.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') { goTo(current - 1); resetAutoplay(); e.preventDefault(); }
    else if (e.key === 'ArrowRight') { goTo(current + 1); resetAutoplay(); e.preventDefault(); }
  });

  /* Touch / swipe support */
  let touchStartX = 0;
  let touchStartY = 0;
  let touchDiffX = 0;
  let swiping = false;

  slider.addEventListener('touchstart', (e) => {
    touchStartX = e.touches[0].clientX;
    touchStartY = e.touches[0].clientY;
    swiping = true;
  }, { passive: true });

  slider.addEventListener('touchmove', (e) => {
    if (!swiping) return;
    touchDiffX = e.touches[0].clientX - touchStartX;
    const diffY = Math.abs(e.touches[0].clientY - touchStartY);
    if (diffY > Math.abs(touchDiffX)) { swiping = false; return; }
  }, { passive: true });

  slider.addEventListener('touchend', () => {
    if (!swiping) return;
    swiping = false;
    if (Math.abs(touchDiffX) > 40) {
      goTo(current + (touchDiffX < 0 ? 1 : -1));
      resetAutoplay();
    }
    touchDiffX = 0;
  });

  /* Init */
  if (autoplay) startAutoplay();
  slider.setAttribute('aria-live', autoplay ? 'off' : 'polite');
});
{% endjavascript %}

{% schema %}
{
  "name": "Polka Pop collection",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-advance slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Slide interval (ms)",
      "min": 2000,
      "max": 9500,
      "step": 500,
      "default": 5000,
      "unit": "ms"
    },
    {
      "type": "text",
      "id": "slider_label",
      "label": "Slider accessibility label",
      "default": "Hero banner slideshow"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image alt text",
          "info": "Overrides the image's own alt text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Slide link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Polka Pop collection v2",
      "blocks": [
        { "type": "slide" }
      ]
    }
  ]
}
