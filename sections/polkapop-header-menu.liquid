<section id="polkapop-header-{{ section.id }}" class="pp-wrap pp-header">
  <div class="pp-inner">
    <nav class="pp-nav" aria-label="Main navigation">
      <a class="pp-logo pp-logo-image-link" href="{{ section.settings.logo_link }}" aria-label="{{ section.settings.logo_text | escape }}">
        <img class="pp-site-logo-image" src="https://cdn.shopify.com/s/files/1/0955/2137/4497/files/polka-logo-white-black.jpg?v=1785127459" alt="{{ section.settings.logo_text | escape }}" width="750" height="750">
      </a>
      <div class="pp-links">
        {% for block in section.blocks %}
          <a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {% endfor %}
      </div>
      <div class="pp-actions">
        <a class="pp-cart" href="{{ section.settings.cart_link }}" aria-label="Cart"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6h15l-2 8H8L6 6Zm0 0L5.25 3.5H2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9" cy="19" r="1.4" fill="currentColor"/><circle cx="17" cy="19" r="1.4" fill="currentColor"/></svg></a>
        <a class="pp-btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      </div>
    </nav>
  </div>
</section>

<style>
  #polkapop-header-{{ section.id }} .pp-logo-image-link {
    height: 58px;
    min-width: 58px;
    display: flex;
    align-items: center;
  }

  #polkapop-header-{{ section.id }} .pp-site-logo-image {
    width: auto;
    height: 58px;
    max-width: 58px;
    object-fit: contain;
    display: block;
  }

  #polkapop-header-{{ section.id }} .pp-cart svg {
    width: 18px;
    height: 18px;
    display: block;
  }
</style>

{% schema %}
{
  "name": "Polka Pop header menu",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "Polka Pop" },
    { "type": "url", "id": "logo_link", "label": "Logo link" },
    { "type": "text", "id": "cart_symbol", "label": "Cart symbol", "default": "Cart" },
    { "type": "url", "id": "cart_link", "label": "Cart link" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "menu_link",
      "name": "Menu link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Polka Pop header menu",
      "blocks": [
        { "type": "menu_link", "settings": { "label": "Collections", "link": "#shop" } },
        { "type": "menu_link", "settings": { "label": "Moments", "link": "#resources" } },
        { "type": "menu_link", "settings": { "label": "Reviews", "link": "#reviews" } },
        { "type": "menu_link", "settings": { "label": "Journal", "link": "#journal" } }
      ]
    }
  ]
}
{% endschema %}
