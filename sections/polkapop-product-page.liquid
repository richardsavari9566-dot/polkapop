<script>
(function(){
const packOptions = document.querySelectorAll('.opt');
    const displayPrice = document.getElementById('displayPrice');
    const displayMrp = document.getElementById('displayMrp');
    const qtyEl = document.getElementById('qty');
    const cartCount = document.getElementById('cartCount');
    const toast = document.getElementById('toast');
    const mainProductImage = document.getElementById('mainProductImage');
    const supportImage = document.getElementById('supportImage');
    let qty = 1;
    let price = 360;

    function money(v){ return '₹' + Number(v).toFixed(0); }

    packOptions.forEach(btn => {
      btn.addEventListener('click', () => {
        packOptions.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        price = Number(btn.dataset.price);
        displayPrice.textContent = money(price);
        displayMrp.textContent = money(btn.dataset.mrp);
      });
    });

    document.getElementById('minus').onclick = () => {
      qty = Math.max(1, qty - 1);
      qtyEl.textContent = qty;
    };

    document.getElementById('plus').onclick = () => {
      qty++;
      qtyEl.textContent = qty;
    };

    function showToast(msg){
      document.getElementById('toastMessage').textContent = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2600);
    }

    document.getElementById('addCart').onclick = () => {
      if (cartCount) cartCount.textContent = Number(cartCount.textContent) + qty;
      showToast('Product added to cart');
    };

    document.getElementById('buyNow').onclick = () => {
      const total = price * qty;
      showToast('Checkout started • Total ' + money(total));
    };

    document.querySelectorAll('.plus').forEach(btn => {
      btn.onclick = () => {
        if (cartCount) cartCount.textContent = Number(cartCount.textContent) + 1;
        showToast('Added to cart');
      };
    });

    document.querySelectorAll('.thumb').forEach((thumb, idx) => {
      thumb.addEventListener('click', () => {
        document.querySelectorAll('.thumb').forEach(t => t.classList.remove('active'));
        thumb.classList.add('active');
        const full = thumb.dataset.full;
        mainProductImage.src = full;
        if (idx === 0) supportImage.src = 'https://cdn.shopify.com/s/files/1/0955/2137/4497/files/polkapop-pdp-04.png?v=1783570995';
        if (idx === 1) supportImage.src = 'https://cdn.shopify.com/s/files/1/0955/2137/4497/files/polkapop-pdp-03.png?v=1783570949';
        if (idx === 2) supportImage.src = 'https://cdn.shopify.com/s/files/1/0955/2137/4497/files/polkapop-pdp-04.png?v=1783570995';
        if (idx === 3) supportImage.src = 'https://cdn.shopify.com/s/files/1/0955/2137/4497/files/polkapop-pdp-03.png?v=1783570949';
      });
    });

    const tabs = {
      details: `<p>Polka Pop Cranberry is a crisp and flavourful sparkling water designed for guilt-free refreshment. It brings together refreshing fizz, a naturally inspired cranberry flavour, and a clean label experience.</p><ul><li>Premium sparkling water</li><li>Zero sugar and zero calories</li><li>Light, crisp, and refreshing</li><li>Convenient 300 ml serving</li><li>Perfect for everyday sipping</li></ul>`,
      ingredients: `<p>Ingredients: Carbonated Water, Natural Cranberry Flavour (Flavouring Substance).</p><ul><li>Simple ingredient profile</li><li>Clean and transparent formulation</li><li>Easy everyday refreshment</li></ul>`,
      nutrition: `<p>Nutrition highlights: 0 calories, 0g sugar, 0g fat, 0mg sodium. One serving = 300 ml.</p><ul><li>Guilt-free refreshment</li><li>No added sugar load</li><li>Fits modern low-calorie lifestyles</li></ul>`,
      why: `<p>Why you'll love it: premium pack appeal, crisp taste, convenient format, and quick-commerce availability.</p><ul><li>Great soda alternative</li><li>Best served chilled</li><li>Refreshing for any time of day</li></ul>`
    };

    document.querySelectorAll('.tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        document.getElementById('tabPanel').innerHTML = tabs[tab.dataset.tab];
      });
    });


    const detailsVideo = document.getElementById('detailsVideo');
    if (detailsVideo) {
      detailsVideo.addEventListener('click', () => {
        showToast('Product details video opened');
      });
    }


    document.querySelectorAll('.feature').forEach(card => {
      card.addEventListener('click', () => {
        document.querySelectorAll('.feature').forEach(c => c.classList.remove('active'));
        card.classList.add('active');
      });
    });

    document.getElementById('checkPincode').onclick = () => {
      const val = document.getElementById('pincodeInput').value.trim();
      const result = document.getElementById('pincodeResult');
      result.style.display = 'block';
      if (/^[0-9]{6}$/.test(val)) {
        result.textContent = 'Available for delivery to pincode ' + val + '.';
        result.style.color = '#2a7b41';
      } else {
        result.textContent = 'Please enter a valid 6-digit pincode.';
        result.style.color = '#c23b3b';
      }
    };
})();
</script>

