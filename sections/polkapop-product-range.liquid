<section id="shop" class="pp-wrap pp-section green">
  <div class="pp-inner">
    <div class="pp-section-head">
      <div class="pp-kicker">{{ section.settings.kicker }}</div>
      <h2 class="pp-title">{{ section.settings.title }}</h2>
      <p class="pp-copy">{{ section.settings.text }}</p>
    </div>
    <div class="pp-grid pp-product-grid">
      {% for block in section.blocks %}
        <article class="pp-card pp-product" {{ block.shopify_attributes }}>
          <span class="pp-pill">{{ block.settings.badge }}</span>
          <div class="pp-product-img">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.image_alt }}
            {% elsif block.settings.image_url != blank %}
              <img src="{{ block.settings.image_url }}" alt="{{ block.settings.image_alt }}" width="900" height="900" loading="lazy">
            {% endif %}
          </div>
          <div class="pp-stars">{{ block.settings.stars }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
          <div class="pp-price-row">
            <span class="pp-price">{{ block.settings.price }}</span>
            <a class="pp-small-btn" href="{{ block.settings.link }}">{{ block.settings.button_label }}</a>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Polka Pop product range",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Shop the range" },
    { "type": "text", "id": "title", "label": "Title", "default": "Trending Polka Pop Flavours" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Pick your favourite zero sugar sparkling water flavour." }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        { "type": "text", "id": "badge", "label": "Badge", "default": "Best Seller" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "image_url", "label": "Fallback image URL" },
        { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Polka Pop bottle" },
        { "type": "text", "id": "stars", "label": "Stars", "default": "★★★★★" },
        { "type": "text", "id": "title", "label": "Title", "default": "Cranberry" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Crisp, tart and fruity without tasting heavy or sweet." },
        { "type": "text", "id": "price", "label": "Price", "default": "Rs. 480" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "View Product" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Polka Pop product range",
      "blocks": [
        { "type": "product_card", "settings": { "badge": "Best Seller", "title": "Cranberry", "image_url": "https://polkapop.in/cdn/shop/files/PolkaPOPlisting_cranberry__1-7-28.png?v=1757614865&width=900", "text": "Crisp, tart and fruity without tasting heavy or sweet." } },
        { "type": "product_card", "settings": { "badge": "Zesty", "title": "Lemon Lime", "image_url": "https://polkapop.in/cdn/shop/files/PolkaPOPlisting_lime-lemon__1-7-21.png?v=1757614099&width=900", "text": "Bright citrus sparkle for a clean, sharp refreshment." } },
        { "type": "product_card", "settings": { "badge": "Fresh", "title": "Orange", "image_url": "https://polkapop.in/cdn/shop/files/PolkaPOPlisting_orange__1-1-36.png?v=1757613042&width=900", "text": "Sunny citrus fizz that works straight or as a mixer." } },
        { "type": "product_card", "settings": { "badge": "Smooth", "title": "Peach", "image_url": "https://polkapop.in/cdn/shop/files/PolkaPOPlisting_peach__1-1-29.png?v=1757612540&width=900", "text": "Soft, smooth and easy refreshment for lighter sipping." } }
      ]
    }
  ]
}
{% endschema %}
