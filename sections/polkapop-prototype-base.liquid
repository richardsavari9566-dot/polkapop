{% javascript %}
(() => {
      const heroVideo = document.querySelector('.pp-split-video-hero video');
      if (heroVideo) {
        heroVideo.muted = true;
        heroVideo.loop = true;
        heroVideo.autoplay = true;
        heroVideo.playsInline = true;
        heroVideo.play().catch(() => {});
      }

      const whyCards = Array.from(document.querySelectorAll('.why-card'));
      const whyExperience = document.querySelector('.why-experience');
      const whyTag = document.querySelector('#whyTag');
      const whyTitle = document.querySelector('#whyTitle');
      const whyText = document.querySelector('#whyText');
      const whyBottle = document.querySelector('#whyBottle');

      const setWhyCard = card => {
        whyCards.forEach(item => item.classList.remove('is-active'));
        card.classList.add('is-active');
        whyExperience?.style.setProperty('--why-soft', card.dataset.soft || '#efffd4');
        whyExperience?.style.setProperty('--why-accent', card.dataset.accent || '#7dbf1d');
        if (whyTag) whyTag.textContent = card.dataset.tag || '';
        if (whyTitle) whyTitle.textContent = card.dataset.title || '';
        if (whyText) whyText.textContent = card.dataset.text || '';
        if (whyBottle) {
          whyBottle.src = card.dataset.img || whyBottle.src;
          whyBottle.alt = (card.dataset.tag || 'Polka Pop') + ' bottle';
        }
      };

      whyCards.forEach(card => {
        card.addEventListener('click', () => setWhyCard(card));
        card.addEventListener('mouseenter', () => setWhyCard(card));
      });

      const momentTabs = Array.from(document.querySelectorAll('.moment-tab'));
      const momentCards = Array.from(document.querySelectorAll('.moment-card[data-moment]'));

      momentTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const filter = tab.dataset.momentFilter || 'all';
          momentTabs.forEach(item => item.classList.remove('is-active'));
          tab.classList.add('is-active');
          momentCards.forEach(card => {
            const isMatch = filter === 'all' || card.dataset.moment === filter;
            card.classList.toggle('is-featured', filter !== 'all' && isMatch);
            card.classList.toggle('is-muted', !isMatch);
          });
        });
      });

      const whySimpleText = document.querySelector('#whySimpleText');
      const whySimpleButtons = Array.from(document.querySelectorAll('.why-simple button'));
      whySimpleButtons.forEach(button => {
        button.addEventListener('click', () => {
          whySimpleButtons.forEach(item => item.classList.remove('is-active'));
          button.classList.add('is-active');
          if (whySimpleText) whySimpleText.textContent = button.dataset.whySimple || '';
        });
      });

      const recipeLab = document.querySelector('.recipe-lab');
      const recipeOptions = Array.from(document.querySelectorAll('[data-recipe-option]'));
      const recipeImage = document.querySelector('#recipeLabImage');
      const recipeTag = document.querySelector('#recipeLabTag');
      const recipeTitle = document.querySelector('#recipeLabTitle');
      const recipeDesc = document.querySelector('#recipeLabDesc');
      const recipeIngredients = document.querySelector('#recipeIngredients');
      const recipeSteps = document.querySelector('#recipeSteps');
      const recipeMore = document.querySelector('#recipeMore');
      const recipeRead = document.querySelector('[data-recipe-more]');

      const activateIngredientButtons = () => {
        Array.from(recipeIngredients?.querySelectorAll('button') || []).forEach(button => {
          button.addEventListener('click', () => {
            button.classList.toggle('is-active');
          });
        });
      };

      const renderRecipeList = (target, items, itemTag) => {
        if (!target) return;
        target.innerHTML = '';
        items.forEach(item => {
          const element = document.createElement(itemTag);
          if (itemTag === 'button') element.type = 'button';
          element.textContent = item;
          target.appendChild(element);
        });
      };

      const setRecipe = option => {
        if (!recipeLab || !option) return;
        recipeOptions.forEach(item => {
          const isActive = item === option;
          item.classList.toggle('is-active', isActive);
          item.setAttribute('aria-selected', String(isActive));
        });
        recipeLab.classList.add('is-changing');
        recipeLab.style.setProperty('--recipe-soft', option.dataset.soft || '#efffd4');
        recipeLab.style.setProperty('--recipe-accent', option.dataset.accent || '#7dbf1d');
        window.setTimeout(() => recipeLab.classList.remove('is-changing'), 220);
        if (recipeImage) {
          recipeImage.src = option.dataset.img || recipeImage.src;
          recipeImage.alt = option.dataset.alt || option.dataset.title || 'Polka Pop recipe';
        }
        if (recipeTag) recipeTag.textContent = option.dataset.tag || '';
        if (recipeTitle) recipeTitle.textContent = option.dataset.title || '';
        if (recipeDesc) recipeDesc.textContent = option.dataset.desc || '';
        renderRecipeList(recipeIngredients, (option.dataset.ingredients || '').split('|').filter(Boolean), 'button');
        recipeIngredients?.querySelector('button')?.classList.add('is-active');
        activateIngredientButtons();
        renderRecipeList(recipeSteps, (option.dataset.steps || '').split('|').filter(Boolean), 'li');
        if (recipeMore) {
          recipeMore.hidden = true;
          recipeMore.textContent = option.dataset.detail || '';
        }
        if (recipeRead) {
          recipeRead.textContent = 'Read More';
          recipeRead.setAttribute('aria-expanded', 'false');
        }
      };

      let recipeIndex = Math.max(0, recipeOptions.findIndex(option => option.classList.contains('is-active')));
      let recipeTimer = window.setInterval(() => {
        if (!recipeOptions.length) return;
        recipeIndex = (recipeIndex + 1) % recipeOptions.length;
        setRecipe(recipeOptions[recipeIndex]);
      }, 2000);

      recipeOptions.forEach((option, optionIndex) => {
        option.addEventListener('click', () => {
          recipeIndex = optionIndex;
          setRecipe(option);
          window.clearInterval(recipeTimer);
          recipeTimer = window.setInterval(() => {
            if (!recipeOptions.length) return;
            recipeIndex = (recipeIndex + 1) % recipeOptions.length;
            setRecipe(recipeOptions[recipeIndex]);
          }, 2000);
        });
      });
      recipeRead?.addEventListener('click', () => {
        if (!recipeMore) return;
        const shouldOpen = recipeMore.hidden;
        recipeMore.hidden = !shouldOpen;
        recipeRead.textContent = shouldOpen ? 'Show Less' : 'Read More';
        recipeRead.setAttribute('aria-expanded', String(shouldOpen));
      });
      activateIngredientButtons();
    })();
{% endjavascript %}

