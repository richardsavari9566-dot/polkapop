{% # theme-check-disable RemoteAsset, ImgWidthAndHeight, CdnPreconnect %}
<link rel="preconnect" href="https://polkapop.in">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<section id="polkapop-prototype-base-{{ section.id }}" class="polkapop-prototype-section polkapop-prototype-base" aria-hidden="true"></section>

{% stylesheet %}
body:has(.polkapop-prototype-section) .shopify-section-group-header-group, body:has(.polkapop-prototype-section) .shopify-section-group-footer-group, body:has(.polkapop-prototype-section) header.shopify-section, body:has(.polkapop-prototype-section) footer.shopify-section, body:has(.polkapop-prototype-section) .announcement-bar, body:has(.polkapop-prototype-section) .announcement-bar-section { display:none !important; }
body:has(.polkapop-prototype-section) main, body:has(.polkapop-prototype-section) #MainContent { padding:0 !important; margin:0 !important; max-width:none !important; }
.polkapop-prototype-section { display:block; width:100%; }
.polkapop-prototype-section #shop.green-section, .polkapop-prototype-section #reviews.green-section { background:var(--green) !important; color:#fff !important; }
:root{
      --cream:#fff9e8;
      --cream-2:#fff5d7;
      --green:#0d7146;
      --green-dark:#06482e;
      --lime:#d9ff48;
      --pink:#ff4778;
      --orange:#ff9d2e;
      --peach:#ffc1a7;
      --yellow:#efff78;
      --ink:#163222;
      --muted:#627263;
      --white:#ffffff;
      --shadow: 0 24px 60px rgba(6, 72, 46, .18);
      --card: rgba(255,255,255,.84);
    }
    *{box-sizing:border-box}
    body{margin:0;background:var(--cream);color:var(--ink);font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;overflow-x:hidden}
    a{text-decoration:none;color:inherit}
    img{max-width:100%;display:block}
    .page{position:relative;overflow:hidden;background:radial-gradient(circle at 20% 10%,#fff6d5 0 22%,transparent 34%),linear-gradient(180deg,#fff9e8 0%,#fff8e8 100%)}
    .top-ribbon{background:var(--green-dark);color:#fff;text-align:center;font-size:12px;letter-spacing:.08em;text-transform:uppercase;padding:6px 16px;font-weight:800}
    .header{position:sticky;top:0;z-index:20;background:#fff;backdrop-filter:none;border-bottom:1px solid rgba(0,0,0,.1)}
    .nav{height:58px;max-width:1220px;margin:auto;display:flex;align-items:center;justify-content:space-between;padding:0 28px}
    .logo{font-family:Fraunces,serif;font-size:27px;font-weight:800;color:#000;letter-spacing:-.04em;display:flex;align-items:center;gap:8px}
    .logo-mark{width:26px;height:26px;border-radius:50%;background:conic-gradient(from 160deg,var(--pink),var(--orange),var(--lime),var(--green));box-shadow:0 0 0 5px rgba(13,113,70,.08)}
    .nav-links{display:flex;align-items:center;gap:24px;font-size:13px;font-weight:800;color:#000}
    .nav-actions{display:flex;align-items:center;gap:12px;font-weight:800;font-size:13px;color:#000}
    .cart{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;border:1px solid rgba(0,0,0,.18);background:#fff;color:#000;font-size:14px}
    .btn{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:999px;padding:12px 20px;font-size:13px;font-weight:900;cursor:pointer;transition:.25s ease;box-shadow:0 10px 24px rgba(13,113,70,.18)}
    .btn-primary{background:var(--green);color:#fff}
    .btn-primary:hover{transform:translateY(-2px);background:var(--green-dark)}
    .btn-lime{background:var(--lime);color:var(--green-dark)}
    .btn-outline{background:transparent;color:var(--green);border:1.5px solid rgba(13,113,70,.28);box-shadow:none}
    .hero{position:relative;min-height:760px;padding:90px 28px 130px;display:grid;place-items:center;isolation:isolate}
    .hero-inner{max-width:1220px;width:100%;display:grid;grid-template-columns:1fr 520px 1fr;align-items:center;gap:36px}
    .eyebrow{display:inline-flex;align-items:center;gap:8px;background:#fff;border:1px solid rgba(13,113,70,.12);border-radius:999px;padding:8px 14px;font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.1em;color:var(--green);box-shadow:0 10px 28px rgba(6,72,46,.07)}
    .hero-copy h1{font-family:Fraunces,serif;font-size:clamp(54px,7vw,104px);line-height:.86;letter-spacing:-.07em;margin:20px 0 18px;color:var(--green-dark)}
    .hero-copy h1 span{display:block;color:var(--pink)}
    .hero-copy p{font-size:19px;line-height:1.65;color:#31513e;margin:0 0 26px;max-width:460px;font-weight:600}
    .hero-actions{display:flex;flex-wrap:wrap;gap:14px}
    .hero-product{position:relative;height:560px;display:grid;place-items:center}
    .halo{position:absolute;width:440px;height:440px;background:radial-gradient(circle,var(--lime) 0 42%,rgba(217,255,72,.5) 43% 62%,transparent 63%);border-radius:50%;filter:blur(.2px);z-index:-1;animation:pulse 5s ease-in-out infinite}
    .bottle-stack{position:relative;width:520px;height:560px}
    .bottle{position:absolute;width:230px;border-radius:26px;filter:drop-shadow(0 34px 36px rgba(6,72,46,.22));animation:floaty 4.5s ease-in-out infinite}
    .bottle.main{left:142px;top:12px;width:260px;z-index:4;animation-delay:.1s}
    .bottle.left{left:16px;top:164px;width:215px;z-index:3;transform:rotate(-10deg);animation-delay:.4s}
    .bottle.right{right:6px;top:174px;width:215px;z-index:2;transform:rotate(10deg);animation-delay:.8s}
    .hero-badge{position:absolute;right:-18px;top:40px;background:#fff;border:2px solid rgba(13,113,70,.12);border-radius:28px;padding:18px 20px;box-shadow:var(--shadow);font-weight:900;z-index:5;text-align:center}
    .hero-badge strong{display:block;font-family:Fraunces,serif;font-size:34px;color:var(--green)}
    .hero-side{display:grid;gap:20px}
    .benefit-card{background:#fff;border:1px solid rgba(13,113,70,.12);border-radius:28px;padding:22px;box-shadow:0 18px 44px rgba(6,72,46,.08)}
    .benefit-card b{font-family:Fraunces,serif;font-size:27px;color:var(--green-dark)}
    .benefit-card p{margin:8px 0 0;color:#526553;line-height:1.55;font-weight:600}
    .fruit{position:absolute;z-index:1;width:88px;height:88px;border-radius:32% 68% 44% 56%/51% 43% 57% 49%;display:grid;place-items:center;font-size:42px;background:#fff;box-shadow:0 18px 35px rgba(6,72,46,.12);animation:drift 7s ease-in-out infinite}
    .fruit.f1{left:8%;top:22%;transform:rotate(-18deg)}
    .fruit.f2{right:9%;top:18%;animation-delay:1.2s}
    .fruit.f3{left:15%;bottom:18%;animation-delay:2s}
    .fruit.f4{right:15%;bottom:21%;animation-delay:.6s}
    .bubble{position:absolute;border-radius:50%;border:1.5px solid rgba(13,113,70,.35);opacity:.55;animation:bubbleUp 8s linear infinite}
    .bubble:nth-child(1){width:18px;height:18px;left:36%;bottom:9%;animation-delay:.4s}
    .bubble:nth-child(2){width:31px;height:31px;left:49%;bottom:4%;animation-delay:2s}
    .bubble:nth-child(3){width:14px;height:14px;left:61%;bottom:14%;animation-delay:3.6s}
    .bubble:nth-child(4){width:24px;height:24px;left:71%;bottom:8%;animation-delay:1.3s}
    .wave{position:absolute;left:0;right:0;bottom:-2px;height:120px;background:var(--green);clip-path:polygon(0 51%,8% 42%,16% 58%,24% 48%,32% 60%,41% 44%,51% 52%,61% 36%,72% 50%,82% 36%,92% 48%,100% 38%,100% 100%,0 100%)}
    .wave:before{content:"";position:absolute;inset:24px 0 0;background:#195f3d;clip-path:polygon(0 42%,12% 60%,24% 48%,36% 66%,48% 50%,60% 69%,72% 42%,85% 60%,100% 45%,100% 100%,0 100%);opacity:.55}
    .section{position:relative;padding:88px 28px}
    .green-section{background:var(--green);color:#fff}
    .container{max-width:1220px;margin:0 auto}
    .section-head{text-align:center;margin-bottom:42px}
    .kicker{font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.16em;color:var(--pink)}
    .green-section .kicker{color:var(--lime)}
    .section-title{font-family:Fraunces,serif;font-size:clamp(36px,5vw,68px);line-height:.98;letter-spacing:-.055em;margin:10px 0;color:var(--green-dark)}
    .green-section .section-title{color:#fff}
    .section-sub{max-width:660px;margin:0 auto;color:#627263;font-size:17px;line-height:1.7;font-weight:600}
    .green-section .section-sub{color:rgba(255,255,255,.78)}
    .why-experience{display:grid;grid-template-columns:.92fr 1.08fr;gap:24px;align-items:stretch}
    .why-stage{position:relative;min-height:480px;border-radius:42px;padding:34px;background:linear-gradient(135deg,var(--why-soft),#fff8e7);overflow:hidden;box-shadow:0 24px 60px rgba(6,72,46,.12);isolation:isolate}
    .why-stage-lifestyle{background-image:linear-gradient(180deg,rgba(5,35,24,.08) 0%,rgba(5,35,24,.18) 38%,rgba(5,35,24,.82) 100%),var(--why-lifestyle-image);background-size:cover;background-position:center;color:#fff}
    .why-stage-lifestyle:before,.why-stage-lifestyle:after{display:none}
    .why-stage.why-stage-lifestyle h3,.why-stage.why-stage-lifestyle p{color:#fff!important;text-shadow:0 2px 12px rgba(0,0,0,.28)}
    .why-stage-lifestyle img{display:none}
    .why-stage:before{content:"";position:absolute;right:-90px;top:-90px;width:260px;height:260px;border-radius:50%;background:var(--why-accent);opacity:.22;z-index:0}
    .why-stage:after{content:"POP";position:absolute;left:24px;bottom:-18px;font-family:Fraunces,serif;font-size:116px;line-height:.8;color:rgba(13,113,70,.06);z-index:0}
    .why-stage-tag{position:relative;z-index:2;display:inline-flex;border-radius:999px;background:var(--green);color:#fff;font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.12em;padding:9px 13px}
    .why-stage h3{position:relative;z-index:2;font-family:Fraunces,serif;font-size:clamp(38px,4vw,64px);line-height:.95;letter-spacing:-.055em;color:var(--green-dark);max-width:360px;margin:24px 0 14px}
    .why-stage p{position:relative;z-index:2;max-width:360px;margin:0;color:#4f6251;font-size:16px;line-height:1.7;font-weight:700}
    .why-stage img{position:absolute;right:34px;bottom:22px;width:260px;max-width:48%;height:auto;object-fit:contain;mix-blend-mode:multiply;filter:drop-shadow(0 30px 34px rgba(6,72,46,.24));animation:whyBottleFloat 5s ease-in-out infinite;z-index:2}
    .why-meter{position:absolute;left:34px;right:34px;bottom:28px;display:grid;grid-template-columns:repeat(4,1fr);gap:8px;z-index:3}
    .why-meter span{height:8px;border-radius:999px;background:rgba(13,113,70,.12);overflow:hidden}
    .why-meter span:before{content:"";display:block;width:100%;height:100%;border-radius:inherit;background:var(--why-accent);transform-origin:left;animation:whyMeter 2.8s ease-in-out infinite}
    .why-meter span:nth-child(2):before{animation-delay:.12s}.why-meter span:nth-child(3):before{animation-delay:.24s}.why-meter span:nth-child(4):before{animation-delay:.36s}
    .why-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
    .why-card{appearance:none;text-align:left;background:#fff;border-radius:28px;padding:22px;border:1px solid rgba(13,113,70,.12);box-shadow:0 18px 34px rgba(6,72,46,.08);position:relative;overflow:hidden;cursor:pointer;transition:transform .32s ease,box-shadow .32s ease,border-color .32s ease}
    .why-card:after{content:"";position:absolute;right:-44px;bottom:-50px;width:120px;height:120px;border-radius:50%;background:var(--lime);opacity:.28;transition:transform .32s ease,opacity .32s ease}
    .why-card:hover,.why-card.is-active{transform:translateY(-8px);box-shadow:0 28px 54px rgba(6,72,46,.14);border-color:rgba(13,113,70,.32)}
    .why-card:hover:after,.why-card.is-active:after{transform:scale(1.25);opacity:.48}
    .why-icon{font-size:18px;margin-bottom:18px;width:58px;height:58px;border-radius:20px;background:#efffd4;color:var(--green);font-weight:900;display:grid;place-items:center}
    .why-card h3{font-family:Fraunces,serif;font-size:26px;line-height:1;margin:0 0 10px;color:var(--green-dark)}
    .why-card p{margin:0;color:#667567;line-height:1.6;font-weight:700;font-size:14px}
    @keyframes whyBottleFloat{0%,100%{transform:translateY(0) rotate(-2deg)}50%{transform:translateY(-14px) rotate(2deg)}}
    @keyframes whyMeter{0%{transform:scaleX(.22)}50%{transform:scaleX(1)}100%{transform:scaleX(.42)}}
    .product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}
    .product-card-link{display:block;color:inherit;text-decoration:none;height:100%}.product-card{background:#fff8e7;color:var(--ink);border-radius:30px;padding:16px;box-shadow:0 20px 46px rgba(0,0,0,.16);position:relative;transition:.25s ease;overflow:hidden}
    .product-card:hover{transform:translateY(-8px) rotate(-.8deg)}
    .badge{position:absolute;top:16px;right:16px;border-radius:999px;background:var(--lime);color:var(--green-dark);font-size:11px;font-weight:900;padding:7px 10px;z-index:2;text-transform:uppercase}
    .product-img{height:245px;border-radius:24px;background:#fff;display:grid;place-items:center;overflow:hidden;margin-bottom:15px}
    .product-img img{height:100%;width:100%;object-fit:cover;transition:.4s ease}
    .product-card:hover .product-img img{transform:scale(1.05)}
    .stars{color:#fdc93b;letter-spacing:1px;font-size:13px;margin-bottom:8px}
    .product-card h3{font-family:Fraunces,serif;font-size:23px;margin:0 0 6px;color:var(--green-dark)}
    .product-card p{margin:0 0 14px;font-size:13px;line-height:1.45;color:#607160;font-weight:600;min-height:38px}
    .price-row{display:flex;align-items:center;justify-content:space-between;gap:12px}
    .price{font-weight:900;color:var(--green-dark)}
    .small-btn{border:0;background:var(--green);color:#fff;border-radius:999px;padding:10px 13px;font-size:12px;font-weight:900;cursor:pointer}
    .commerce{display:grid;grid-template-columns:1.1fr repeat(3,1fr);gap:20px;align-items:stretch}
    .commerce-intro{border-radius:36px;background:var(--green-dark);color:#fff;padding:32px;position:relative;overflow:hidden}
    .commerce-intro:after{content:"10-15 min";position:absolute;right:-20px;bottom:-18px;font-family:Fraunces,serif;font-size:64px;letter-spacing:-.06em;color:rgba(217,255,72,.18)}
    .commerce-intro h2{font-family:Fraunces,serif;font-size:42px;line-height:1;margin:0 0 12px;letter-spacing:-.04em}
    .commerce-intro p{margin:0;color:rgba(255,255,255,.76);line-height:1.6;font-weight:600}
    .commerce-card{background:#fff;border:1px solid rgba(13,113,70,.12);border-radius:30px;padding:26px;text-align:center;box-shadow:0 14px 36px rgba(6,72,46,.08);display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:238px}
    .commerce-logo{height:82px;width:168px;border-radius:24px;margin:0 auto 18px;display:flex;align-items:center;justify-content:center;background:#fff;border:1px solid rgba(13,113,70,.10);box-shadow:0 12px 28px rgba(6,72,46,.08);padding:16px}
    .commerce-logo img{max-width:100%;max-height:54px;object-fit:contain}
    .commerce-logo.bl{background:#f8d91e}.commerce-logo.bl img{max-height:62px}.commerce-logo.ze img{max-height:48px}.commerce-logo.sw img{max-height:48px}
    .commerce-card h3{margin:0 0 14px;font-size:20px;color:var(--green-dark)}
    .spotlight{background:var(--lime);padding:100px 28px 110px;position:relative;overflow:hidden}
    .spotlight:before{content:"";position:absolute;top:-70px;left:-5%;width:110%;height:130px;background:var(--green);clip-path:polygon(0 0,100% 0,100% 38%,90% 58%,78% 42%,63% 64%,51% 43%,39% 60%,25% 44%,12% 66%,0 46%)}
    .spotlight-grid{max-width:1220px;margin:0 auto;display:grid;grid-template-columns:1fr 420px 1fr;gap:40px;align-items:center}
    .stats{display:grid;gap:24px}
    .stat{border-left:4px solid var(--green);padding-left:18px}
    .stat small{display:block;font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.12em;color:#4e672c;margin-bottom:6px}
    .stat b{font-family:Fraunces,serif;font-size:30px;color:var(--green-dark)}
    .spotlight-product{position:relative;display:grid;place-items:center;min-height:470px}
    .spotlight-product:before{content:"";position:absolute;width:330px;height:330px;border-radius:50%;background:#fff9e8;box-shadow:0 30px 90px rgba(6,72,46,.18)}
    .spotlight-product img{position:relative;z-index:2;width:330px;mix-blend-mode:multiply;filter:drop-shadow(0 32px 34px rgba(6,72,46,.25));animation:floaty 5s ease-in-out infinite}
    .spotlight-copy h2{font-family:Fraunces,serif;font-size:clamp(44px,5vw,76px);line-height:.92;letter-spacing:-.06em;color:var(--green-dark);margin:0 0 20px}
    .spotlight-copy p{font-size:18px;line-height:1.65;color:#39512d;font-weight:700;margin:0 0 24px}
    .moment-tabs{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin:-18px 0 30px}
    .moment-tab{appearance:none;border:1px solid rgba(13,113,70,.16);background:#fff;border-radius:999px;color:var(--green-dark);font-weight:900;padding:11px 16px;cursor:pointer;box-shadow:0 10px 24px rgba(6,72,46,.06);transition:transform .25s ease,background .25s ease,color .25s ease,border-color .25s ease}
    .moment-tab:hover,.moment-tab.is-active{transform:translateY(-3px);background:var(--green);color:#fff;border-color:var(--green)}
    .moments{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;align-items:stretch}
    .moment-card{min-height:372px;border-radius:34px;padding:18px 18px 24px;background:#fff;box-shadow:0 20px 46px rgba(6,72,46,.09);position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:space-between;transition:transform .45s cubic-bezier(.16,.86,.24,1), box-shadow .45s ease, opacity .25s ease, filter .25s ease}
    .moment-card:before{content:"";position:absolute;inset:-50px -40px auto auto;width:170px;height:170px;border-radius:50%;background:var(--moment-soft,#ffeaf0);opacity:.88;z-index:0}
    .moment-card:after{content:"";position:absolute;left:-34px;bottom:-38px;width:130px;height:130px;border-radius:40% 60% 55% 45%;background:var(--moment-accent,#ff4778);opacity:.14;z-index:0}
    .moment-card:hover,.moment-card.is-featured{transform:translateY(-12px) rotate(-1.5deg);box-shadow:0 32px 66px rgba(6,72,46,.16)}
    .moment-card.is-muted{opacity:.34;filter:saturate(.4);transform:scale(.97)}
    .moment-card.work{--moment-soft:#e9fff1;--moment-accent:#7dbf1d}.moment-card.meal{--moment-soft:#fff0d8;--moment-accent:#ff8a2a}.moment-card.mocktail{--moment-soft:#ffeaf0;--moment-accent:#ff4778}.moment-card.party{--moment-soft:#ecf0ff;--moment-accent:#7e63ff}
    .moment-badge{position:relative;z-index:2;width:max-content;border-radius:999px;background:var(--green);color:#fff;font-size:11px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;padding:8px 11px}
    .moment-scene{position:relative;z-index:1;height:168px;border-radius:26px;margin:16px 0 18px;background:linear-gradient(135deg,var(--moment-soft),#fff);display:grid;place-items:center;overflow:hidden}
    .moment-scene:before{content:"";position:absolute;inset:auto 22px 18px;height:16px;border-radius:50%;background:rgba(6,72,46,.12);filter:blur(6px);transform:scaleX(.8);animation:momentShadow 5.5s ease-in-out infinite}
    .moment-scene img{height:146px;object-fit:contain;mix-blend-mode:multiply;filter:drop-shadow(0 22px 22px rgba(6,72,46,.16));animation:momentBottle 5.5s ease-in-out infinite}
    .moment-emoji{position:absolute;font-size:34px;filter:drop-shadow(0 10px 16px rgba(6,72,46,.12));animation:momentFloat 6s ease-in-out infinite}.moment-emoji.e1{left:20px;top:18px}.moment-emoji.e2{right:22px;bottom:20px;animation-delay:.8s}.moment-emoji.e3{left:50%;bottom:16px;animation-delay:1.4s}
    .moment-card h3{position:relative;z-index:2;font-family:Fraunces,serif;font-size:30px;line-height:1;margin:0 0 8px;color:var(--green-dark);letter-spacing:-.04em}
    .moment-card p{position:relative;z-index:2;margin:0;color:#607160;line-height:1.55;font-weight:700;font-size:14px}
    .moment-link{position:relative;z-index:2;margin-top:16px;display:inline-flex;color:var(--green);font-size:13px;font-weight:900}
    @keyframes momentBottle{0%,100%{transform:translateY(0) rotate(-1deg)}50%{transform:translateY(-10px) rotate(2deg)}}
    @keyframes momentShadow{0%,100%{transform:scaleX(.75);opacity:.55}50%{transform:scaleX(1);opacity:.25}}
    @keyframes momentFloat{0%,100%{transform:translateY(0) rotate(0deg)}50%{transform:translateY(-12px) rotate(8deg)}}
    .review-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
    .review{background:#fff8e7;border-radius:30px;padding:28px;color:var(--ink);box-shadow:0 18px 42px rgba(0,0,0,.12)}
    .review .quote{font-size:15px;line-height:1.75;color:#31513e;font-weight:600;margin:14px 0 22px}
    .person{display:flex;align-items:center;gap:12px}
    .avatar{width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,var(--pink),var(--orange));display:grid;place-items:center;color:#fff;font-weight:900}
    .person b{display:block;color:var(--green-dark)}
    .person span{font-size:12px;color:#70806f;font-weight:700}
    .recipe-lab-section{background:linear-gradient(180deg,#fffaf0 0%,#f8ffef 100%)}
