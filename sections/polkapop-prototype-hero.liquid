<section id="polkapop-prototype-hero-{{ section.id }}" class="polkapop-prototype-section">
  <div class="page">
    <section class="pp-hero pp-split-video-hero" aria-label="Polka Pop homepage video banner">
      <div class="pp-ingredient-field" aria-hidden="true"></div>
      <div class="pp-video-panel">
        <video class="pp-full-video" autoplay muted loop playsinline preload="metadata" aria-label="Polka Pop sparkling water banner video">
          <source src="https://cdn.shopify.com/videos/c/vp/b83a73086734464bb126da7dac8f6763/b83a73086734464bb126da7dac8f6763.HD-720p-4.5Mbps-89935385.mp4" type="video/mp4" data-hero-video-source>
        </video>
      </div>
    </section>
  </div>
</section>

{% schema %}
{
  "name": "PP prototype hero",
  "settings": [],
  "presets": [
    {
      "name": "PP prototype hero"
    }
  ]
}
{% endschema %}
