<section id="polkapop-prototype-shell-{{ section.id }}" class="polkapop-prototype-section">
  <div class="page">
    <div class="top-ribbon">ZERO SUGAR &bull; ZERO CALORIES &bull; ZERO SWEETENERS &bull; FULLY FIZZY</div>
    <header class="header">
      <nav class="nav">
        <a class="logo logo-image-link" href="#" aria-label="Polka Pop home"><img class="site-logo-image" src="https://cdn.shopify.com/s/files/1/0955/2137/4497/files/polka-logo-white-black.jpg?v=1785127459" alt="Polka Pop" width="750" height="750"></a>
        <div class="nav-links">
          <a href="#about">About us</a>
          <a href="{{ routes.all_products_collection_url }}">Collections</a>
          <a href="#resources">Resources</a>
          <a href="#combos">Combos</a>
          <a href="#gifts">Gift Packs</a>
        </div>
        <div class="nav-actions"><a class="cart" href="{{ routes.cart_url }}" aria-label="Cart"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6h15l-2 8H8L6 6Zm0 0L5.25 3.5H2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9" cy="19" r="1.4" fill="currentColor"/><circle cx="17" cy="19" r="1.4" fill="currentColor"/></svg></a><a class="btn btn-primary" href="{{ routes.all_products_collection_url }}">Shop Now</a></div>
      </nav>
    </header>
  </div>
</section>

<style>
  #polkapop-prototype-shell-{{ section.id }} .logo-image-link {
    height: 58px;
    min-width: 58px;
    align-items: center;
  }

  #polkapop-prototype-shell-{{ section.id }} .site-logo-image {
    width: auto;
    height: 58px;
    max-width: 58px;
    object-fit: contain;
    display: block;
  }

  #polkapop-prototype-shell-{{ section.id }} .cart svg {
    width: 18px;
    height: 18px;
    display: block;
  }
</style>

{% schema %}
{
  "name": "PP prototype header",
  "settings": [],
  "presets": [
    {
      "name": "PP prototype header"
    }
  ]
}
{% endschema %}
