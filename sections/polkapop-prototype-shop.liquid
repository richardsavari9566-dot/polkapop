<section id="polkapop-prototype-shop-{{ section.id }}" class="polkapop-prototype-section">
  <div class="page">
    <section class="section green-section" id="shop">
      <div class="container">
        <div class="section-head"><div class="kicker">Shop the range</div><h2 class="section-title">Trending Polka Pop Flavours</h2><p class="section-sub">A cleaner product-card system with bigger visuals, stronger CTA placement, and enough breathing room for users who are somehow still expected to read.</p></div>
        <div class="product-grid">
          <article class="product-card"><a class="product-card-link" href="/products/cranberry-sparkling-water-300ml-each-packs-of-12-24" aria-label="View Cranberry product"><span class="badge">Best Seller</span><div class="product-img"><img src="https://polkapop.in/cdn/shop/files/PolkaPOPlisting_cranberry__1-7-28.png?v=1757614865&width=900" alt="Cranberry"></div><div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div><h3>Cranberry</h3><p>Crisp, tart and fruity without tasting heavy or sweet.</p><div class="price-row"><span class="price">Rs. 480</span><span class="small-btn">View Product</span></div></a></article>
          <article class="product-card"><span class="badge">Zesty</span><div class="product-img"><img src="https://polkapop.in/cdn/shop/files/PolkaPOPlisting_lime-lemon__1-7-21.png?v=1757614099&width=900" alt="Lemon Lime"></div><div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div><h3>Lemon Lime</h3><p>Bright citrus sparkle for a clean, sharp refreshment.</p><div class="price-row"><span class="price">Rs. 480</span><button class="small-btn">View Product</button></div></article>
          <article class="product-card"><span class="badge">Fresh</span><div class="product-img"><img src="https://polkapop.in/cdn/shop/files/PolkaPOPlisting_orange__1-1-36.png?v=1757613042&width=900" alt="Orange"></div><div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div><h3>Orange</h3><p>Sunny citrus fizz that works straight or as a mixer.</p><div class="price-row"><span class="price">Rs. 480</span><button class="small-btn">View Product</button></div></article>
          <article class="product-card"><span class="badge">Smooth</span><div class="product-img"><img src="https://polkapop.in/cdn/shop/files/PolkaPOPlisting_peach__1-1-29.png?v=1757612540&width=900" alt="Peach"></div><div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div><h3>Peach</h3><p>Soft, smooth and easy refreshment for lighter sipping.</p><div class="price-row"><span class="price">Rs. 480</span><button class="small-btn">View Product</button></div></article>
        </div>
      </div>
    </section>
  </div>
</section>

