<section id="polkapop-prototype-why-{{ section.id }}" class="polkapop-prototype-section">
  <div class="page">
    <section class="section" id="about">
      <div class="container">
        <div class="section-head"><div class="kicker">Why Polka Pop</div><h2 class="section-title">Tap Into the Fizz</h2></div>
        <div class="why-experience" style="--why-soft:#efffd4;--why-accent:#7dbf1d;">
          <div class="why-stage why-stage-lifestyle" id="whyStage" style="--why-lifestyle-image:url('https://cdn.shopify.com/s/files/1/0955/2137/4497/files/Lemon-lime_Lifestyle.png?v=1785075997');">
            <span class="why-stage-tag" id="whyTag">Zero Sugar</span>
            <h3 id="whyTitle">Light fizz without the sugar load.</h3>
            <p id="whyText">Zero sugar, zero calories and no heavy sweet finish, made for everyday chilled sipping.</p>
            <div class="why-meter"><span></span><span></span><span></span><span></span></div>
            <img id="whyBottle" src="https://polkapop.in/cdn/shop/files/PolkaPOPlisting_lime-lemon__1-7-21.png?v=1757614099&width=760" alt="Lemon Lime Polka Pop">
          </div>
          <div class="why-grid" aria-label="Choose a Polka Pop benefit">
            <button class="why-card is-active" type="button" data-soft="#efffd4" data-accent="#7dbf1d" data-tag="Zero Sugar" data-title="Light fizz without the sugar load." data-text="Zero sugar, zero calories and no heavy sweet finish, made for everyday chilled sipping." data-img="https://polkapop.in/cdn/shop/files/PolkaPOPlisting_lime-lemon__1-7-21.png?v=1757614099&width=760"><div class="why-icon">01</div><h3>Zero Sugar</h3><p>A cleaner sip when you want flavour without heaviness.</p></button>
            <button class="why-card" type="button" data-soft="#ffe8ee" data-accent="#ff4778" data-tag="Fruit Led" data-title="Flavours that feel bright." data-text="Cranberry, citrus, orange and peach profiles designed to taste crisp, not syrupy." data-img="https://polkapop.in/cdn/shop/files/PolkaPOPlisting_lime-lemon__1-7-21.png?v=1757614099&width=760"><div class="why-icon">02</div><h3>Bright Flavours</h3><p>Fruit-forward sparkle with a clean finish.</p></button>
            <button class="why-card" type="button" data-soft="#fff0d8" data-accent="#ff8a2a" data-tag="Full Fizz" data-title="Cold, crisp bubbles." data-text="Built for chilled refreshment, quick breaks, mixers and mocktails." data-img="https://polkapop.in/cdn/shop/files/PolkaPOPlisting_lime-lemon__1-7-21.png?v=1757614099&width=760"><div class="why-icon">03</div><h3>Full Fizz</h3><p>Sharp bubbles that make each sip feel fresh.</p></button>
            <button class="why-card" type="button" data-soft="#fff7d7" data-accent="#d9ff48" data-tag="Moment Ready" data-title="Easy for every plan." data-text="Keep it ready for desk breaks, food pairings, house parties and quick-commerce cravings." data-img="https://polkapop.in/cdn/shop/files/PolkaPOPlisting_lime-lemon__1-7-21.png?v=1757614099&width=760"><div class="why-icon">04</div><h3>Moment Ready</h3><p>Drink it straight or use it as a mixer.</p></button>
          </div>
        </div>
      </div>
    </section>
  </div>
</section>

{% schema %}
{
  "name": "PP prototype why",
  "settings": [],
  "presets": [
    {
      "name": "PP prototype why"
    }
  ]
}
{% endschema %}
