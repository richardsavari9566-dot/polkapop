<div id="polkapop-style-base-{{ section.id }}" class="polkapop-style-base" style="--pp-green: {{ section.settings.green }}; --pp-lime: {{ section.settings.lime }}; --pp-cream: {{ section.settings.cream }}; --pp-ink: {{ section.settings.ink }};"></div>

{% stylesheet %}
body:has(.polkapop-style-base) .shopify-section-group-header-group,
body:has(.polkapop-style-base) .shopify-section-group-footer-group,
body:has(.polkapop-style-base) header.shopify-section,
body:has(.polkapop-style-base) footer.shopify-section,
body:has(.polkapop-style-base) .announcement-bar,
body:has(.polkapop-style-base) .announcement-bar-section{display:none!important}
body:has(.polkapop-style-base){background:#fff!important}
.pp-wrap{--green:var(--pp-green,#0d7146);--lime:var(--pp-lime,#d8ff3e);--cream:var(--pp-cream,#fffdf0);--ink:var(--pp-ink,#24110d);font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:#fff;overflow:hidden}
.pp-wrap *{box-sizing:border-box}.pp-wrap a{text-decoration:none;color:inherit}.pp-inner{max-width:1180px;margin:0 auto;padding:0 24px}.pp-btn{display:inline-flex;align-items:center;justify-content:center;border-radius:999px;border:2px solid var(--green);background:var(--green);color:#fff;font-weight:900;font-size:14px;line-height:1;padding:15px 24px;box-shadow:0 6px 0 #06482e;transition:transform .25s ease,box-shadow .25s ease}.pp-btn:hover{transform:translateY(-3px);box-shadow:0 9px 0 #06482e}.pp-btn.secondary{background:#fff;color:var(--green);box-shadow:0 5px 0 rgba(6,72,46,.18)}.pp-kicker{font-weight:900;color:var(--green);font-size:14px;letter-spacing:.02em}.pp-title{font-family:Georgia,serif;font-weight:900;font-size:clamp(36px,5vw,74px);line-height:.95;margin:8px 0 16px;letter-spacing:0}.pp-copy{font-size:17px;line-height:1.7;color:#31513e;font-weight:650}.pp-section{padding:76px 0}.pp-section.green{background:var(--green);color:#fff}.pp-section.green .pp-kicker,.pp-section.green .pp-copy{color:#ecffd1}.pp-section-head{text-align:center;max-width:760px;margin:0 auto 34px}.pp-grid{display:grid;gap:24px}.pp-card{border-radius:28px;background:#fff;color:var(--ink);box-shadow:0 18px 42px rgba(6,72,46,.1);overflow:hidden}.pp-pill{display:inline-flex;border:2px solid var(--green);border-radius:999px;background:var(--lime);color:var(--green);font-size:12px;font-weight:900;padding:7px 14px;box-shadow:0 4px 0 var(--green)}.pp-marquee{background:var(--lime);border-top:2px solid var(--green);border-bottom:2px solid var(--green);color:var(--green);font-weight:950;overflow:hidden;white-space:nowrap}.pp-marquee-track{display:flex;width:max-content;animation:ppMarquee var(--speed,22s) linear infinite}.pp-marquee-item{padding:8px 22px;font-size:13px}.pp-marquee:hover .pp-marquee-track{animation-play-state:paused}@keyframes ppMarquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.pp-header{background:#fff;position:sticky;top:0;z-index:20;border-bottom:1px solid rgba(0,0,0,.1)}.pp-nav{height:58px;display:flex;align-items:center;justify-content:space-between;gap:22px}.pp-logo{font-family:Georgia,serif;font-weight:950;color:#000;font-size:26px}.pp-links{display:flex;gap:24px;align-items:center;font-size:13px;font-weight:900;color:#000}.pp-actions{display:flex;gap:12px;align-items:center;color:#000}.pp-cart{font-size:20px;color:#000}
.pp-hero{position:relative;min-height:690px;background:#fff}.pp-video-hero{min-height:calc(100vh - 58px);background:#fff;overflow:hidden}.pp-hero-video{width:100%;height:calc(100vh - 58px);min-height:640px;display:block;object-fit:cover;object-position:center center;background:#fff}.pp-slide{position:absolute;inset:0;opacity:0;pointer-events:none;transition:opacity .7s ease}.pp-slide.is-active{opacity:1;pointer-events:auto}.pp-slide-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.pp-slide-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(255,235,219,.92),rgba(255,235,219,.52) 44%,rgba(255,235,219,.05) 72%)}.pp-hero-content{position:relative;z-index:2;min-height:690px;display:grid;grid-template-columns:minmax(280px,520px) 1fr;align-items:center;gap:20px}.pp-hero-text{padding-top:20px}.pp-hero-product{display:flex;justify-content:center;align-items:flex-end;min-height:520px}.pp-hero-bottle{max-height:480px;max-width:100%;filter:drop-shadow(0 28px 32px rgba(64,30,16,.22));animation:ppFloat 4.8s ease-in-out infinite}.pp-hero-actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:24px}.pp-dots{position:absolute;left:50%;bottom:24px;transform:translateX(-50%);display:flex;gap:10px;z-index:4}.pp-dot{width:11px;height:11px;border:0;border-radius:50%;background:rgba(13,113,70,.32);cursor:pointer}.pp-dot.is-active{background:var(--green);transform:scale(1.2)}@keyframes ppFloat{50%{transform:translateY(-14px) rotate(1deg)}}
.pp-product-grid{grid-template-columns:repeat(4,1fr)}.pp-product{padding:22px;text-align:center;position:relative}.pp-product-img{height:260px;display:flex;align-items:center;justify-content:center;background:#f6ffe7;border-radius:22px;margin-bottom:16px}.pp-product-img img{max-height:235px;max-width:100%;object-fit:contain}.pp-stars{color:#ffb000;font-size:13px;letter-spacing:2px}.pp-product h3,.pp-moment h3,.pp-review b{font-family:Georgia,serif;font-size:25px;margin:8px 0}.pp-price-row{display:flex;gap:12px;align-items:center;justify-content:space-between;margin-top:18px}.pp-price{font-weight:950;color:var(--green)}.pp-small-btn{border:0;background:var(--green);color:#fff;border-radius:999px;padding:11px 15px;font-size:12px;font-weight:900}
.pp-moment-grid{grid-template-columns:repeat(4,1fr)}.pp-moment{padding:24px;text-align:center}.pp-moment-img{height:230px;display:flex;align-items:center;justify-content:center;background:#fff8df;border-radius:24px}.pp-moment-img img{max-height:210px;object-fit:contain}.pp-moment-link{display:inline-block;margin-top:12px;color:var(--green);font-weight:900}
.pp-review-grid{grid-template-columns:repeat(3,1fr)}.pp-review{padding:28px;background:#fff8e7}.pp-review .quote{font-size:15px;line-height:1.75;color:#31513e;font-weight:650}.pp-person{display:flex;gap:12px;align-items:center}.pp-avatar{width:42px;height:42px;border-radius:50%;background:var(--green);color:#fff;display:grid;place-items:center;font-weight:900}.pp-person span{display:block;font-size:12px;color:#5b705f}
.pp-recipe-layout{display:grid;grid-template-columns:1.1fr .9fr;gap:26px;align-items:stretch}.pp-recipe-showcase{border-radius:32px;background:#ffe8ee;padding:36px;min-height:520px}.pp-recipe-showcase h3{font-family:Georgia,serif;font-size:56px;line-height:.95;margin:8px 0 12px}.pp-recipe-visual{height:300px;display:flex;align-items:center;justify-content:center}.pp-recipe-visual img{max-height:285px;filter:drop-shadow(0 22px 22px rgba(0,0,0,.18))}.pp-recipe-steps{display:flex;gap:10px;flex-wrap:wrap}.pp-recipe-steps span{background:#fff;border-radius:999px;padding:9px 13px;font-weight:850;color:var(--green)}.pp-recipe-menu{display:grid;gap:15px}.pp-recipe-choice{text-align:left;border:1px solid rgba(13,113,70,.16);background:#fff;border-radius:24px;padding:20px;cursor:pointer;box-shadow:0 14px 28px rgba(6,72,46,.08)}.pp-recipe-choice.is-selected{border-color:var(--green);transform:translateY(-3px)}
.pp-faq-list{max-width:880px;margin:auto;display:grid;gap:14px}.pp-faq-list details{background:#fff;border:1px solid rgba(13,113,70,.16);border-radius:20px;padding:20px}.pp-faq-list summary{cursor:pointer;font-weight:950;color:var(--green)}.pp-faq-list p{line-height:1.65;color:#31513e;margin-bottom:0}
.pp-blog{background:#fbfff0;padding:72px 0}.pp-blog-layout{display:grid;grid-template-columns:1.1fr .9fr;gap:26px;align-items:start}.pp-blog-image{display:block;border-radius:8px;overflow:hidden;background:#fff}.pp-blog-image img{width:100%;height:100%;object-fit:cover;display:block}.pp-blog-feature .pp-blog-image{aspect-ratio:1.68}.pp-blog-row{display:grid;grid-template-columns:1.05fr .95fr;gap:18px;align-items:center;margin-bottom:28px}.pp-blog-row .pp-blog-image{aspect-ratio:1.7}.pp-blog h3{font-family:Georgia,serif;font-size:22px;line-height:1.02;margin:18px 0 12px}.pp-blog-read{font-weight:800}.pp-blog-action{text-align:center;margin-top:34px}
.pp-footer{background:#063b2a;color:#fff;padding:62px 0 28px}.pp-footer-grid{display:grid;grid-template-columns:1.5fr repeat(3,1fr);gap:30px}.pp-footer h3,.pp-footer h4{font-family:Georgia,serif;margin-top:0}.pp-footer a,.pp-footer p{display:block;color:#d9f9de;line-height:1.8}.pp-copyright{border-top:1px solid rgba(255,255,255,.16);margin-top:34px;padding-top:18px;display:flex;justify-content:space-between;gap:18px;color:#bde8c6;font-size:13px}
@media (max-width:980px){.pp-links{display:none}.pp-hero,.pp-hero-content{min-height:auto}.pp-video-hero{min-height:auto}.pp-hero-video{height:auto;min-height:0;aspect-ratio:16/9}.pp-hero-content{grid-template-columns:1fr;padding:70px 24px 92px;text-align:center}.pp-hero-product{min-height:auto}.pp-hero-bottle{max-height:360px}.pp-product-grid,.pp-moment-grid,.pp-review-grid,.pp-blog-layout,.pp-recipe-layout,.pp-footer-grid{grid-template-columns:1fr 1fr}.pp-blog-layout,.pp-recipe-layout{grid-template-columns:1fr}.pp-section{padding:58px 0}}
@media (max-width:640px){.pp-inner{padding:0 18px}.pp-title{font-size:40px}.pp-nav{height:auto;padding:14px 0}.pp-actions .pp-btn{display:none}.pp-hero-video{aspect-ratio:9/14;min-height:560px;object-position:center center}.pp-hero-content{text-align:left}.pp-hero-actions{align-items:stretch}.pp-hero-actions .pp-btn{width:100%}.pp-product-grid,.pp-moment-grid,.pp-review-grid,.pp-footer-grid,.pp-blog-row{grid-template-columns:1fr}.pp-blog{padding:52px 0}.pp-copyright{display:block}.pp-recipe-showcase h3{font-size:38px}}
{% endstylesheet %}

{% schema %}
{
  "name": "Polka Pop style base",
  "settings": [
    { "type": "color", "id": "green", "label": "Brand green", "default": "#0d7146" },
    { "type": "color", "id": "lime", "label": "Accent lime", "default": "#d8ff3e" },
    { "type": "color", "id": "cream", "label": "Cream", "default": "#fffdf0" },
    { "type": "color", "id": "ink", "label": "Text color", "default": "#24110d" }
  ],
  "presets": [
    { "name": "Polka Pop style base" }
  ]
}
{% endschema %}
