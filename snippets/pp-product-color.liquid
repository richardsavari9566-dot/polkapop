  {%- assign pc_deep = '#991031' -%}
  {%- assign pc_lime = '#ffd4dc' -%}
  {%- assign pc_soft = '#fff1f4' -%}
  {%- assign c1 = '#ffe5ea' -%}
  {%- assign c2 = '#ffc8d3' -%}
  {%- assign c3 = '#feaaba' -%}
  {%- assign c4 = '#fe8da5' -%}
  {%- assign c5 = '#fe7089' -%}
  {%- assign c6 = '#6e0b23' -%}
  {%- assign c5t = '#062f28' -%}
  {%- assign lt = '#062f28' -%}
  {%- assign dkr = '#6e0b23' -%}
  {%- assign ml = '#feb5c4' -%}
{%- elsif product_name contains 'lemon' -%}
  {%- assign pc = '#b8c400' -%}
  {%- assign pc_deep = '#5c6600' -%}
  {%- assign pc_lime = '#f5ff66' -%}
  {%- assign pc_soft = '#fdffe6' -%}
  {%- assign c1 = '#fdffe6' -%}
  {%- assign c2 = '#f9ffc6' -%}
  {%- assign c3 = '#eef5a0' -%}
  {%- assign c4 = '#d5de60' -%}
  {%- assign c5 = '#b8c420' -%}
  {%- assign c6 = '#3d4400' -%}
  {%- assign c5t = '#062f28' -%}
  {%- assign lt = '#062f28' -%}
  {%- assign dkr = '#3d4400' -%}
  {%- assign ml = '#e8f0a0' -%}
{%- elsif product_name contains 'peach' -%}
  {%- assign pc = '#e88a5a' -%}
  {%- assign pc_deep = '#994b1e' -%}
  {%- assign pc_lime = '#ffd4b8' -%}
  {%- assign pc_soft = '#fff5ef' -%}
  {%- assign c1 = '#fff5ef' -%}
  {%- assign c2 = '#ffe7d8' -%}
  {%- assign c3 = '#ffd9c2' -%}
  {%- assign c4 = '#ffcbab' -%}
  {%- assign c5 = '#e8a080' -%}
  {%- assign c6 = '#6e3615' -%}
  {%- assign c5t = '#062f28' -%}
  {%- assign lt = '#062f28' -%}
  {%- assign dkr = '#6e3615' -%}
  {%- assign ml = '#ffe0d0' -%}
{%- elsif product_name contains 'orange' -%}
  {%- assign pc = '#f5920a' -%}
  {%- assign pc_deep = '#a35e00' -%}
  {%- assign pc_lime = '#ffd699' -%}
  {%- assign pc_soft = '#fff4e0' -%}
  {%- assign c1 = '#fff4e0' -%}
  {%- assign c2 = '#ffe6b8' -%}
  {%- assign c3 = '#ffd68a' -%}
  {%- assign c4 = '#ffc35c' -%}
  {%- assign c5 = '#f5a530' -%}
  {%- assign c6 = '#6e3f00' -%}
  {%- assign c5t = '#062f28' -%}
  {%- assign lt = '#062f28' -%}
  {%- assign dkr = '#6e3f00' -%}
  {%- assign ml = '#ffe0b0' -%}
{%- elsif product_name contains 'blueberry' -%}
  {%- assign pc = '#3a7ac9' -%}
  {%- assign pc_deep = '#1e509a' -%}
  {%- assign pc_lime = '#aecbe9' -%}
  {%- assign pc_soft = '#e5eff8' -%}
  {%- assign c1 = '#e5eff8' -%}
  {%- assign c2 = '#c4dbf0' -%}
  {%- assign c3 = '#9dc0e4' -%}
  {%- assign c4 = '#77a5d8' -%}
  {%- assign c5 = '#5c8ec5' -%}
  {%- assign c6 = '#132841' -%}
  {%- assign c5t = '#ffffff' -%}
  {%- assign lt = '#ffffff' -%}
  {%- assign dkr = '#132841' -%}
  {%- assign ml = '#aecbe9' -%}
{%- else -%}
  {%- assign pc = '#3a7ac9' -%}
  {%- assign pc_deep = '#1e509a' -%}
  {%- assign pc_lime = '#aecbe9' -%}
  {%- assign pc_soft = '#e5eff8' -%}
  {%- assign c1 = '#e5eff8' -%}
  {%- assign c2 = '#c4dbf0' -%}
  {%- assign c3 = '#9dc0e4' -%}
  {%- assign c4 = '#77a5d8' -%}
  {%- assign c5 = '#5c8ec5' -%}
  {%- assign c6 = '#132841' -%}
  {%- assign c5t = '#ffffff' -%}
  {%- assign lt = '#ffffff' -%}
  {%- assign dkr = '#132841' -%}
  {%- assign ml = '#aecbe9' -%}
{%- endif -%}
{%- assign pct52 = '52' | append: '%' -%}
<style>
#pp-pdp{--green:{{ pc }};--green-deep:{{ pc_deep }};--lime:{{ pc_lime }};--blue:{{ pc }};--blue-deep:{{ pc_deep }};--blue-soft:{{ pc_soft }};--product-color:{{ pc }}}
#pp-pdp .secondary{color:{{ lt }}}
#pp-pdp .editorial-card:nth-child(1){background:{{ c1 }} !important;color:#062f28 !important}
#pp-pdp .editorial-card:nth-child(1) h3{color:#062f28 !important}
#pp-pdp .editorial-card:nth-child(2){background:{{ c2 }} !important;color:#062f28 !important}
#pp-pdp .editorial-card:nth-child(2) h3{color:#062f28 !important}
#pp-pdp .editorial-card:nth-child(3){background:{{ c3 }} !important;color:#062f28 !important}
#pp-pdp .editorial-card:nth-child(3) h3{color:#062f28 !important}
#pp-pdp .editorial-card:nth-child(4){background:{{ c4 }} !important;color:#062f28 !important}
#pp-pdp .editorial-card:nth-child(4) h3{color:#062f28 !important}
#pp-pdp .editorial-card:nth-child(5){background:{{ c5 }} !important;color:{{ c5t }} !important}
#pp-pdp .editorial-card:nth-child(5) h3{color:{{ c5t }} !important}
#pp-pdp .editorial-card:nth-child(6){background:{{ c6 }} !important;color:#ffffff !important}
#pp-pdp .editorial-card:nth-child(6) h3{color:#ffffff !important}
#pp-pdp .pdp-recipe-showcase{background:linear-gradient(158deg,{{ pc_soft }},{{ pc_lime }} {{ pct52 }},{{ pc_soft }}) !important}
#pp-pdp .wave-section{background:{{ pc_deep }} !important}
#pp-pdp .wave-section::before{background:{{ pc_deep }} !important}
#pp-pdp .wave-section .section-kicker{color:{{ pc_lime }} !important}
#pp-pdp .cta-banner{background:linear-gradient(120deg,{{ pc_soft }},{{ c1 }}) !important;border-color:{{ pc_lime }} !important}
#pp-pdp .benefit{border-color:{{ pc_soft }} !important}
.pp-ptr-dots button.on{background:{{ pc }} !important}
#pp-pdp .product-editorial-intro{display:none !important}
/* Notify Me button + rearranged purchase layout */
#pp-pdp .purchase-row{display:grid !important;grid-template-columns:auto 1fr;grid-template-rows:auto auto;gap:10px !important;align-items:stretch}
#pp-pdp .purchase-row .qty{grid-column:1;grid-row:1}
#pp-pdp .purchase-row .pp-notify-btn{grid-column:2;grid-row:1;display:inline-flex;align-items:center;justify-content:center;gap:6px;background:transparent;border:2px solid {{ pc }};color:{{ pc }};border-radius:14px;font-size:14px;font-weight:700;cursor:pointer;padding:0 18px;font-family:inherit;transition:background .2s,color .2s}
#pp-pdp .purchase-row .pp-notify-btn:hover{background:{{ pc_soft }}}
#pp-pdp .purchase-row .pp-notify-btn svg{width:16px;height:16px;fill:currentColor}
#pp-pdp .purchase-row .primary.add-cart{grid-column:1;grid-row:2}
#pp-pdp .purchase-row #buyNow{grid-column:2;grid-row:2;margin-top:0 !important;width:auto !important}
/* Notify Me modal */
.pp-notify-overlay{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:9999;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s}
.pp-notify-overlay.is-open{opacity:1;pointer-events:auto}
.pp-notify-modal{background:#fff;border-radius:20px;padding:36px 32px;max-width:420px;width:90%;position:relative;box-shadow:0 20px 60px rgba(0,0,0,.18);transform:translateY(20px);transition:transform .25s}
.pp-notify-overlay.is-open .pp-notify-modal{transform:translateY(0)}
.pp-notify-modal .pp-nm-close{position:absolute;top:14px;right:14px;background:none;border:none;font-size:22px;cursor:pointer;color:#999;line-height:1;padding:4px}
.pp-notify-modal .pp-nm-close:hover{color:#333}
.pp-notify-modal .pp-nm-icon{width:48px;height:48px;border-radius:50%;background:{{ pc_soft }};display:flex;align-items:center;justify-content:center;margin:0 auto 16px}
.pp-notify-modal .pp-nm-icon svg{width:24px;height:24px;fill:{{ pc }}}
.pp-notify-modal h3{font-size:20px;font-weight:800;color:#1a1a1a;text-align:center;margin:0 0 6px;letter-spacing:-.02em}
.pp-notify-modal p{font-size:14px;color:#666;text-align:center;margin:0 0 20px;line-height:1.5}
.pp-notify-modal .pp-nm-input{width:100%;padding:14px 16px;border:2px solid #e5e7eb;border-radius:12px;font-size:15px;font-family:inherit;outline:none;transition:border-color .2s;box-sizing:border-box}
.pp-notify-modal .pp-nm-input:focus{border-color:{{ pc }}}
.pp-notify-modal .pp-nm-submit{width:100%;margin-top:12px;padding:14px;background:{{ pc }};color:#fff;border:none;border-radius:12px;font-size:15px;font-weight:700;cursor:pointer;font-family:inherit;transition:background .2s}
.pp-notify-modal .pp-nm-submit:hover{background:{{ pc_deep }}}
.pp-notify-modal .pp-nm-success{text-align:center;padding:20px 0}
.pp-notify-modal .pp-nm-success svg{width:48px;height:48px;margin-bottom:12px}
.pp-notify-modal .pp-nm-success h3{margin-bottom:4px}
</style>
<script>
(function(){
  var pc='{{ pc }}',deep='{{ pc_deep }}',light='{{ pc_soft }}',lime='{{ pc_lime }}',lt='{{ lt }}',dkr='{{ dkr }}',ml='{{ ml }}';
  function applyColors(){
    var p=document.querySelector('#pp-pdp .primary');
    if(p){p.style.setProperty('background',lime,'important');p.style.setProperty('border','1px solid '+pc,'important');p.style.setProperty('color','#062f28','important');}
    var s=document.querySelector('#pp-pdp .secondary')||document.querySelector('#pp-pdp #buyNow');
    if(s){s.style.setProperty('background',deep,'important');s.style.setProperty('color','#ffffff','important');s.style.setProperty('border','1px solid '+deep,'important');}
    var rm=document.querySelector('#pp-pdp .pdp-recipe-more');
    if(rm){rm.style.setProperty('background',pc,'important');rm.style.setProperty('color',lt,'important');}
    document.querySelectorAll('#pp-pdp .add-circle').forEach(function(b){b.style.setProperty('border-color',pc,'important');b.style.setProperty('color',pc,'important');});
    var nb=document.querySelector('#pp-pdp .newsletter button');
    if(nb){nb.style.setProperty('background',pc,'important');nb.style.setProperty('color',lt,'important');}
    document.querySelectorAll('#pp-pdp .option.active').forEach(function(o){o.style.setProperty('border-color',pc,'important');o.style.setProperty('box-shadow','inset 0 0 0 1px '+pc,'important');o.style.setProperty('background',light,'important');});
  }
  function rearrangeButtons(){
    var row=document.querySelector('#pp-pdp .purchase-row');
    var buyNow=document.querySelector('#pp-pdp #buyNow');
    var qty=row&&row.querySelector('.qty');
    if(!row||!buyNow||!qty) return;
    buyNow.style.marginTop='0';
    row.appendChild(buyNow);
    var notifyBtn=document.createElement('button');
    notifyBtn.type='button';
    notifyBtn.className='pp-notify-btn';
    notifyBtn.innerHTML='<svg viewBox="0 0 24 24"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/></svg> Notify Me';
    qty.insertAdjacentElement('afterend',notifyBtn);
    var overlay=document.createElement('div');
    overlay.className='pp-notify-overlay';
    overlay.innerHTML='<div class="pp-notify-modal">'+
      '<button class="pp-nm-close" aria-label="Close">&times;</button>'+
      '<div class="pp-nm-icon"><svg viewBox="0 0 24 24"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/></svg></div>'+
      '<h3>Get Notified</h3>'+
      '<p>Enter your email and we’ll let you know about restocks, new flavours and exclusive drops.</p>'+
      '<form class="pp-nm-form" method="post" action="/contact#contact_form">'+
        '<input type="hidden" name="form_type" value="customer">'+
        '<input type="hidden" name="utf8" value="✓">'+
        '<input type="hidden" name="contact[tags]" value="notify-me,'+('{{ product.title }}'.replace(/'/g,''))+'">'+
        '<input class="pp-nm-input" type="email" name="contact[email]" placeholder="Enter your email" required>'+
        '<button class="pp-nm-submit" type="submit">Notify Me</button>'+
      '</form>'+
    '</div>';
    document.body.appendChild(overlay);
    notifyBtn.addEventListener('click',function(){overlay.classList.add('is-open');});
    overlay.querySelector('.pp-nm-close').addEventListener('click',function(){overlay.classList.remove('is-open');});
    overlay.addEventListener('click',function(e){if(e.target===overlay) overlay.classList.remove('is-open');});
    var form=overlay.querySelector('.pp-nm-form');
    form.addEventListener('submit',function(e){
      e.preventDefault();
      var email=form.querySelector('input[type="email"]').value;
      var fd=new FormData(form);
      fetch('/contact#contact_form',{method:'POST',body:fd,headers:{'X-Requested-With':'XMLHttpRequest'}}).then(function(){
        overlay.querySelector('.pp-notify-modal').innerHTML='<button class="pp-nm-close" aria-label="Close">&times;</button>'+
          '<div class="pp-nm-success">'+
            '<svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="24" fill="'+light+'"/><path d="M15 24l6 6 12-12" stroke="'+pc+'" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>'+
            '<h3>You’re on the list!</h3>'+
            '<p style="color:#666;font-size:14px">We’ll email you at <strong>'+email+'</strong> with updates.</p>'+
          '</div>';
        overlay.querySelector('.pp-nm-close').addEventListener('click',function(){overlay.classList.remove('is-open');});
      }).catch(function(){form.submit();});
    });
  }
  if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',function(){applyColors();rearrangeButtons();});}else{applyColors();rearrangeButtons();}
  setTimeout(applyColors,500);
  var pdpEl=document.querySelector('#pp-pdp');
  if(pdpEl&&pdpEl.previousSibling&&pdpEl.previousSibling.nodeType===3){pdpEl.parentNode.removeChild(pdpEl.previousSibling);}
  var ecopy=document.querySelector('#pp-pdp .product-editorial-copy');
  if(ecopy){var h=ecopy.querySelector('h2'),hhtml=h?h.outerHTML:'';var ps=ecopy.querySelectorAll('p'),txt='';ps.forEach(function(p){txt+=p.textContent.trim()+' '});ecopy.innerHTML=hhtml+'<p>'+txt.trim()+'</p>';}
})();
</script>
{%- endif -%}